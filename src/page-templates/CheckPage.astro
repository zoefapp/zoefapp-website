---
import { HttpTripClient } from "~/api/client/client";
import { CheckClaimForm } from "~/components/ui/stations/_check.ts";
import Layout from "~/layouts/Layout.astro";
import {ClientFetchHttpService}  from '~/api/client/lib/client'

interface Props {}

const {} = Astro.props;

let input = CheckClaimForm.safeParse({
    departure: Astro.url.searchParams.get("departure"),
    arrival: Astro.url.searchParams.get("arrival"),
    date: Astro.url.searchParams.get("date"),
});

let trips: any[] = []

if (input.success) {
    let baseUrl = import.meta.env.ZOEF_API_BASEURL

    let api = new HttpTripClient(baseUrl, new ClientFetchHttpService())

    trips = await api.tripFromRouteV1({
        departureStation: input.data.departure,
        destinationStation: input.data.arrival,
        departureTime: input.data.date
    })
}

---

<Layout title="Welcome to Astro.">
    <main>
        {input.success ? (
            <h1>success: {JSON.stringify(trips)}</h1>
        ) : (
            <h2>failure: {input.error}</h2>
        )}
    </main>
</Layout>
