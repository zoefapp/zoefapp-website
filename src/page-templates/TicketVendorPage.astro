---
// Utils
import { getLanguage, useTranslations } from "~/i18n/utils";
const lang = getLanguage(Astro);
const t = useTranslations(lang);
// Layout
import Layout from "~/layouts/Layout.astro";
// Images
import TicketVendorBackgroundImage from "~/assets/images/backgrounds/ticket-vendor-bg.png";
import FaqsRedImage from "~/assets/images/faqs-red.png";
// Icons
import ClockCheckIcon from "~/assets/images/icons/clock-check.png";
import EuroIcon from "~/assets/images/icons/euro-icon-green.png";
import StarIcon from "~/assets/images/icons/star.png";
// Components
import Accomplisments from "~/components/Accomplisments.astro";
import Blogs from "~/components/Blogs.astro";
import Brands from "~/components/Brands.astro";
import Faqs from "~/components/Faqs.astro";
import Hero from "~/components/Hero.astro";
import HowZoefWorks from "~/components/HowZoefWorks.astro";
import Stats from "~/components/Stats.astro";
import Subtitle from "~/components/ui/Subtitle.astro";
import Title from "~/components/ui/Title.astro";
import { getPageContent } from "~/lib/page";
import SignUpForm from "~/pages/partial/signup/_form.astro";

// const TrustPilotData = {
//     review_count: 20,
//     star_count: 5,
//     review_market: "AppStore",
// };
const StatsData = [
    {
        description: "Automatische bepaling of een claim gegrond is. ",
    },
    {
        description: "Volledig automatische financiële afhandeling.",
    },
    {
        description: "Geautomatiseerde communicatie met de reiziger.",
    },
];
const AccomplishmentsData = [
    {
        count: 2545,
        description: t("accompaniment.first"),
        icon: EuroIcon,
    },
    {
        count: 4566,
        description: t("accompaniment.second"),
        icon: StarIcon,
    },
    {
        count: 3455,
        description: t("accompaniment.third"),
        icon: ClockCheckIcon,
    },
];

let pageContent = await getPageContent(getLanguage(Astro), "ticketvendor");
---

<Layout page={pageContent.data}>
    <main class="theme-ticket-vendor px-2 max-md:px-0">
        <Hero heroImage={TicketVendorBackgroundImage}>
            <Fragment slot="left">
                <Title>
                    {pageContent.data.title}
                </Title>
                <Subtitle variant="default">{pageContent.data.description}</Subtitle>
                <SignUpForm type="TICKETVENDOR" />
                <!-- <TrustPilotRatings data={TrustPilotData} /> -->
            </Fragment>
            <Stats data={StatsData} slot="floating" />
        </Hero>
        <Brands />
        <Accomplisments data={AccomplishmentsData} />
        <HowZoefWorks type="ticketvendor-a" />
        <HowZoefWorks type="ticketvendor-b" orientation="right" />
        <!-- <Testimonials relevantFor="ticketvendor" /> -->
        <Faqs image={FaqsRedImage} relevantFor="ticketvendor" />
        <Blogs />
    </main>
</Layout>
