---
import type { BlogContentEntry } from "~/lib/blog";
import { useRoutesAstro } from "~/i18n/utils";
import Layout from "~/layouts/Layout.astro";

interface Props {
    blog: BlogContentEntry;
}

const { blog } = Astro.props;
const { Content } = await blog.render();

const routes = useRoutesAstro(Astro)
---

<Layout title="Welcome to Astro.">
    <main>
        <h1>Blog: {blog.data.title}</h1>
        <Content />
        <ul>
            <!-- {
                blog.translations.map((translation) => (
                    <li>
                        <a href={translation.href}>
                            {translation.language} - {translation.title}
                        </a>
                    </li>
                ))
            } -->
        </ul>
        <ul>
            {
                blog.data.tags.map((tag) => (
                    <li>
                        <a href={routes('blogTag')(tag)}>{tag}</a>
                    </li>
                ))
            }
        </ul>
    </main>
</Layout>

<style>
    body {
        background-color: white;
    }
</style>
