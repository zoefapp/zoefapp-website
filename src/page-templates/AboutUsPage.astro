---
import Layout from "~/layouts/Layout.astro";
// Images
import AboutUsBackgroundImage from "~/assets/images/backgrounds/about-us-bg.jpg";
// Utils
import { Image } from "astro:assets";
import Banner from "~/components/Banner.astro";
import { getPageContent } from "~/lib/page";
import { getLanguage } from "~/i18n/utils";
import { Icon } from "astro-icon/components";
import { getPeople } from "~/lib/people";
import PeopleProfilePhoto from "~/components/PeopleProfilePhoto.astro";

let people = await getPeople();
let pageContent = await getPageContent(getLanguage(Astro), "aboutus");
let { Content } = await pageContent.render();
---

<Layout page={pageContent?.data}>
    <main class="theme-passenger">
        <section class="relative w-full">
            <section class="container flex flex-col gap-6 pt-24 text-skin-base">
                <h1 class="text-center text-[20px] font-bold">{pageContent.data.title}</h1>
                <h2
                    class="text-center text-[clamp(1.5rem,4vw,2.5rem)] font-bold md:w-1/2 text-balance md:mx-auto leading-tight"
                >
                    {pageContent.data.description}
                </h2>
                <div class="mt-14 justify-center items-center flex">
                    <div class="relative lg:w-3/4">
                        <Image
                            class="rounded-lg brightness-25"
                            src={AboutUsBackgroundImage}
                            alt="Blog Placeholder Image"
                            format="webp"
                            decoding="async"
                            quality={100}
                            loading="eager"
                            fetchpriority="high"
                        />
                        <div class="absolute inset-0 flex flex-col items-center justify-center text-white">
                            <div class="content w-1/2">
                                <Content />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <div
                class="absolute inset-x-0 top-0 bottom-[10%] md:bottom-[30%] lg:bottom-[30%] bg-skin-gradient rounded-b-3xl md:rounded-t-3xl -z-10"
            >
            </div>
        </section>
        <section class="container grid grid-cols-1 md:grid-cols-2 gap-4 mt-16 w-[90%]">
            <div class="p-6 content">
                <Content />
            </div>
            <div class="p-6">
                <Image
                    class="rounded-lg brightness-25"
                    src={AboutUsBackgroundImage}
                    alt="Blog Placeholder Image"
                    format="webp"
                    decoding="async"
                    quality={100}
                    loading="eager"
                    fetchpriority="high"
                />
            </div>
        </section>

        <section class="container bg-gray-50 w-[90%] p-8 rounded-2xl mt-16">
            <h2 class="text-skin-secondary font-bold text-[clamp(1.4rem,4vw,1.7rem)]">Who's making it all work?</h2>
            <div class="flex justify-center flex-wrap gap-4">
                {
                    people.map((person) => (
                        <div class="p-6 flex flex-col items-center rounded-lg">
                            <PeopleProfilePhoto person={person} />
                            <h2 class="text-lg font-bold flex gap-2 items-center">
                                {person.data.countryIcon && (
                                    <Icon name={person.data.countryIcon} aria-label={person.data.country ?? ""} />
                                )}
                                {person.data.name}
                            </h2>
                            <p class="text-sm">{person.data.title}</p>
                            <ul class="mt-4 flex space-x-4">
                                {person.data.socials.map((social) => (
                                    <li class="flex gap-4 items-center text-[14px]">
                                        <a
                                            class="hover:underline"
                                            href={social.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <Icon name={social.icon} class="w-5 h-5" aria-label={social.label} />
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </section>
        <Banner type="store" />
    </main>
</Layout>
