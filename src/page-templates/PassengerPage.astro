---
// Utils
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Layout
import Layout from "~/layouts/Layout.astro";
// Images
import PassengerBackgroundImage from "~/assets/images/passenger-bg.png";
// Components
import Title from "~/components/ui/title.astro";
import Subtitle from "~/components/ui/subtitle.astro";
import TrustPilotRatings from "~/components/trust-pilot-ratings.astro";
---

<Layout title="Welcome to Astro.">
    <main class="px-2 max-md:px-0">
        <section
            class="flex md:rounded-lg overflow-clip flex-col bg-gradient-to-b lg:bg-gradient-to-r from-passenger to-transparent lg:flex-row justify-between"
        >
            <aside class="2xl:pl-[calc((100vw-1400px)/2)] px-5 flex flex-col gap-10 w-full lg:w-1/2 py-2 lg:py-32">
                <Title variant="passenger">
                    {t("passenger.title")}
                </Title>
                <Subtitle>{t("passenger.description")}</Subtitle>
                <TrustPilotRatings data={{ review_count: 336, star_count: 5, review_market: "AppStore" }} />
            </aside>
            <aside class="w-full max-w-2xl max-lg:mx-auto lg:w-1/2">
                <Image
                    class="w-full"
                    format="avif"
                    loading={"eager"}
                    decoding={"async"}
                    src={PassengerBackgroundImage}
                    alt="Passenger Background"
                />
            </aside>
        </section>
    </main>
</Layout>
