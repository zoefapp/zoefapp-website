---
// Utils
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Layout
import Layout from "~/layouts/Layout.astro";
// Images
import PassengerBackgroundImage from "~/assets/images/passenger-bg.png";
// Components
import Title from "~/components/ui/title.astro";
import Subtitle from "~/components/ui/subtitle.astro";
import TrustPilotRatings from "~/components/trust-pilot-ratings.astro";
import CompensationCheck from "~/components/compensation-check.astro";
import Hero from "~/components/hero.astro";

const TrustPilotData = {
    review_count: 336,
    star_count: 5,
    review_market: "AppStore",
};
---

<Layout title="Welcome to Astro.">
    <main class="theme-passenger px-2 max-md:px-0">
        <Hero heroImage={PassengerBackgroundImage}>
            <Fragment slot="left">
                <Title>
                    {t("passenger.title")}
                </Title>
                <Subtitle>{t("passenger.description")}</Subtitle>
                <TrustPilotRatings data={TrustPilotData} />
            </Fragment>
            <CompensationCheck slot="floating" />
        </Hero>
    </main>
</Layout>
