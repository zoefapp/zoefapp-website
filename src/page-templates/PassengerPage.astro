---
// Utils
import { getLanguage } from "~/i18n/utils";
// Layout
import Layout from "~/layouts/Layout.astro";
// Images
import PassengerBackgroundImage from "~/assets/images/backgrounds/passenger-bg2.png";
import FaqsGreenImage from "~/assets/images/faqs-green.png";
// Components
import StoreBanner from "~/components/Banner.astro";
import Blogs from "~/components/Blogs.astro";
import CompensationCheck from "~/components/compensation/CompensationCheck.astro";
import Faqs from "~/components/Faqs.astro";
import Hero from "~/components/Hero.astro";
import HowZoefWorks from "~/components/HowZoefWorks.astro";
import Testimonials from "~/components/Testimonials.astro";
import TrustPilotRatings from "~/components/TrustPilotRatings.astro";
import Subtitle from "~/components/ui/Subtitle.astro";
import Title from "~/components/ui/Title.astro";
import { getPageContent } from "~/lib/page";
import CompensationCheckModal from "~/components/compensation/CompensationCheckModal.astro";

const TrustPilotData = {
    review_count: 20,
    star_count: 5,
    review_market: "AppStore",
};

let pageContent = await getPageContent(getLanguage(Astro), "passenger");
---

<Layout page={pageContent.data}>
    <main class="theme-passenger px-5 max-md:px-0">
        <Hero homePage heroImage={PassengerBackgroundImage}>
            <Fragment slot="left">
                <Title>
                    {pageContent.data.title}
                </Title>
                <Subtitle variant="default">{pageContent.data.description}</Subtitle>
                <TrustPilotRatings data={TrustPilotData} />
            </Fragment>
            <CompensationCheck slot="floating" />
        </Hero>
        <HowZoefWorks type="passenger" />
        <Testimonials relevantFor="passenger" />
        <Faqs image={FaqsGreenImage} relevantFor="passenger" />
        <Blogs />
        <StoreBanner type="store" />
    </main>
    <CompensationCheckModal />
</Layout>
