---
// Layout
import Layout from "~/layouts/Layout.astro";
// Utils
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
// Images
import StepperBackgroundImage from "~/assets/images/backgrounds/stepper-bg.png";
import Subtitle from "~/components/ui/Subtitle.astro";
import Collapsable from "~/components/ui/collapsable/Collapsable.astro";
import CollapsableTrigger from "~/components/ui/collapsable/CollapsableTrigger.astro";
import CollapsableContent from "~/components/ui/collapsable/CollapsableContent.astro";
import TravelRoute from "~/components/TravelRoute.astro";
import ProgressButton from "~/components/ui/ProgressButton.astro";
// Data
const steps = [
    { id: 1, title: "Reis keizen", icon: "lucide:check", active: true },
    { id: 2, title: "Hoodie LaCroix", icon: "lucide:dot", active: false },
    { id: 3, title: "Pour-over godard", icon: "lucide:dot", active: false },
    { id: 4, title: "Lomo mumblecore", icon: "lucide:dot", active: false },
];
---

<Layout title="Welcome to Astro.">
    <main class="container theme-passenger">
        <section class="container">
            <aside class="flex items-center justify-between gap-6 py-8 overflow-x-scroll hide-scrollbar">
                {
                    steps.map((step, index) => (
                        <Fragment key={step.id}>
                            <div class={`flex gap-3 font-bold ${step.active ? "" : "opacity-50"} shrink-0`}>
                                <Icon name={step.icon} class="w-6 h-6 rounded-full text-skin-base bg-passenger p-1" />
                                <h2>
                                    {step.id}. {step.title}
                                </h2>
                            </div>
                            {index !== steps.length - 1 && (
                                <div class="border bg-black min-w-10 md:min-w-20 lg:min-w-32" />
                            )}
                        </Fragment>
                    ))
                }
            </aside>
        </section>
        <section class="bg-gradient-to-b lg:bg-gradient-to-r from-skin-gradient to-transparent rounded-[24px]">
            <section class="flex flex-col lg:flex-row justify-between gap-2">
                <aside class="flex flex-col lg:w-1/2 gap-6 px-12 py-12 lg:py-24 lg:pl-12">
                    <h1 class="text-[clamp(1.5rem,4vw,44px)] font-bold text-balance text-skin-base">
                        ✅ Jij hebt mogelijk recht op teruggave!
                    </h1>
                    <Subtitle variant="default">Geschatte vertraging: <strong>30 min</strong></Subtitle>
                </aside>
                <aside class="lg:w-1/2 rounded-r-[24px] overflow-clip">
                    <Image
                        src={StepperBackgroundImage}
                        loading={"eager"}
                        decoding={"async"}
                        format={"avif"}
                        width={800}
                        quality={80}
                        alt="Stepper Background"
                        class="w-full h-full object-cover"
                    />
                </aside>
            </section>
        </section>
        <Collapsable>
            <CollapsableTrigger className="flex justify-end items-center w-full text-start">
                <section class="flex items-center gap-4 mr-auto">
                    <Subtitle variant="default" className="font-bold whitespace-nowrap">Geplande reis</Subtitle>
                    <Icon name="lucide:circle-help" class="w-4 h-4 text-orange-light" />
                </section>
                <section class="flex flex-col md:flex-row text-[clamp(14px,2vw,16px)] gap-2 md:gap-4 mx-4">
                    <h2>Transfers: <strong class="text-[clamp(14px,2vw,18px)]">1x</strong></h2>
                    <h2>Normale reistijd: <strong class="text-[clamp(14px,2vw,18px)]">50min</strong></h2>
                </section>
            </CollapsableTrigger>
            <CollapsableContent className="flex flex-col gap-9 rounded-2xl p-5 md:p-8 bg-gray-50">
                <TravelRoute type="default" />
                <section class="flex justify-between">
                    <aside class="flex flex-col gap-1">
                        <h2>Vertrek station</h2>
                        <p class="font-bold text-[18px]">Maastricht Centraal</p>
                        <p>14:04</p>
                    </aside>
                    <aside class="flex flex-col gap-1 text-end">
                        <h2>Gewenste bestemming</h2>
                        <p class="font-bold text-[18px]">Den Haag Centraal</p>
                        <p>14:04</p>
                    </aside>
                </section>
            </CollapsableContent>
        </Collapsable>
        <Collapsable>
            <CollapsableTrigger className="flex justify-end items-center w-full text-start">
                <div class="flex flex-col gap-4 mr-auto">
                    <section class="flex items-center gap-4 mr-auto">
                        <Subtitle variant="default" className="font-bold">Vertraagde reis</Subtitle>
                        <Icon name="lucide:circle-help" class="w-4 h-4 text-orange-light" />
                    </section>
                    <p class="text-[clamp(14px,2vw,16px)] text-balance font-medium">
                        Uit onze berekening schatten wij dat je de volgende route nam:
                    </p>
                </div>
                <section class="flex flex-col md:flex-row text-[clamp(14px,2vw,16px)] gap-2 md:gap-4 mx-1 md:mx-4">
                    <h2>Transfers: <strong class="text-[clamp(14px,2vw,18px)]">3x</strong></h2>
                    <h2>Normale reistijd: <strong class="text-red-600 text-[clamp(14px,2vw,18px)]">80min</strong></h2>
                </section>
            </CollapsableTrigger>
            <CollapsableContent className="flex flex-col gap-9">
                <section class="flex flex-col gap-9 rounded-2xl p-5 lg:p-8 bg-gray-50">
                    <TravelRoute type="secondary" />
                    <section class="flex justify-between">
                        <aside class="flex flex-col gap-1">
                            <h2>Vertrek station</h2>
                            <p class="font-bold text-[18px]">Maastricht Centraal</p>
                            <p>14:04</p>
                        </aside>
                        <aside class="flex flex-col gap-1 text-end">
                            <h2>Mijn exit</h2>
                            <p class="font-bold text-[18px]">Den Haag Centraal</p>
                            <p>14:34</p>
                        </aside>
                    </section>
                </section>
                <section class="flex flex-col md:flex-row gap-4">
                    <ProgressButton type="cancel" />
                    <ProgressButton type="confirm" />
                </section>
            </CollapsableContent>
        </Collapsable>
        <section class="flex flex-wrap gap-8 py-8">
            <aside class="flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-red-500"></div>
                <p class="text-sm font-medium">Extra overstap</p>
            </aside>
            <aside class="flex items-center gap-2">
                <div class="w-4 h-4 rounded-full bg-skin-gradient"></div>
                <p class="text-sm font-medium">Standaard overstap</p>
            </aside>
            <aside class="flex items-center gap-2">
                <div class="w-6 h-[2px] border"></div>
                <p class="text-sm font-medium">Standaard reistijd</p>
            </aside>
            <aside class="flex items-center gap-2">
                <div class="w-6 h-[2px] border border-dashed border-red-500"></div>
                <p class="text-sm font-medium">Standaard reistijd</p>
            </aside>
        </section>
    </main>
</Layout>
