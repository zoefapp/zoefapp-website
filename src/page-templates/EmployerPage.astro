---
import { useRoutesAstro } from "~/i18n/utils";
import Layout from "~/layouts/Layout.astro";
let routes = useRoutesAstro(Astro);
---

<Layout title="Welcome to Astro.">
    <main class="theme-employer text-skin-base">
        <h1>Employer Page: {routes("employer")}</h1>
        <ul>
            <li><a href={routes("passenger")}>Passenger</a></li>
        </ul>
    </main>
</Layout>
