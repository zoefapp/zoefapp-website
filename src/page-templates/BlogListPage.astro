---
import BlogHero from "~/components/BlogHero.astro";
import BlogsGrid from "~/components/BlogsGrid.astro";
import Layout from "~/layouts/Layout.astro";
import { getBlogsWithPagination } from "~/lib/blog";
import { getLanguage } from "~/i18n/utils";
import type { PageProps } from "~/lib/page";
const page = Astro.url.searchParams.get("page") || 1;
const lang = getLanguage(Astro);
const blogs = await getBlogsWithPagination(lang, 15, Number(page));

const pageProps: PageProps = { title: "Test" }
---

<Layout page={pageProps}>
    <main class="theme-passenger px-2 max-md:px-0">
        <BlogHero />
        <BlogsGrid blogs={blogs} />
        <!-- <Pagination page={page} /> -->
    </main>
</Layout>
