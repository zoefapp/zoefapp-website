---
import Layout from "~/layouts/Layout.astro";

interface Props {
    contentId: string;
}

const { contentId } = Astro.props;
---

<Layout title="Welcome to Astro.">
    <main>
        <h1>ContentId:: {contentId}</h1>
    </main>
</Layout>

<style>
    body {
        background-color: white;
    }
</style>
