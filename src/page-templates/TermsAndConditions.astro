---
interface Props {
    type: "privacy" | "terms";
}

import Layout from "~/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getLanguage, useRoutes, useTranslations } from "~/i18n/utils";
import { getPageContent } from "~/lib/page";

const lang = getLanguage(Astro);
const t = useTranslations(lang);
const r = useRoutes(lang)


let pageContent = await getPageContent(lang, Astro.props.type)

const { Content, headings } = await pageContent.render()
const toc = headings.filter((heading) => heading.depth == 2);

---

<Layout>
    <main class="theme-passenger">
        <section class="flex flex-col relative w-full">
            <section
                class="container gap-8 font-bold flex flex-col md:flex-row md:items-center justify-between pt-20 pb-8"
            >
                <aside class="gap-3 flex flex-col md:w-1/2">
                    <h1 class="text-[clamp(1.5rem,4vw,2.5rem)] text-skin-base font-bold">{pageContent.data.title}</h1>
                    {pageContent.data.lastUpdated && (
                        <p class="text-[15px] font-bold">{t('content.lastupdated')} {pageContent.data.lastUpdated.toLocaleDateString()}</p>
                    )}
                </aside>
                <aside class="flex gap-4">
                    <a
                        class="flex items-center gap-1 border border-skin-base md:border-none rounded-lg px-3 py-2 font-bold text-black"
                        href={r('terms')}
                    >
                        <p>{t('footer.terms')}</p>
                        <Icon name="lucide:arrow-right" class="md:hidden w-4 h-4 shrink-0" />
                    </button>
                    <a
                        class="flex items-center gap-1 border border-skin-base md:border-none rounded-lg px-3 py-2 font-bold text-black"
                        href={r('privacy')}
                    >
                        <p>{t('footer.privacy')}</p>
                        <Icon name="lucide:arrow-right" class="md:hidden w-4 h-4 shrink-0" />
                    </button>
                </aside>
            </section>
            <div class="absolute inset-0 bg-skin-gradient -z-10 rounded-b-3xl md:rounded-b-2xl"></div>
        </section>
        <section class="container flex flex-col lg:flex-row gap-4">
            <ul
                class="lg:sticky h-max left-0 top-14 px-2 2xl:px-0 mt-14 flex flex-col gap-1 font-opensans list-disc list-inside text-orange-light text-sm text-start"
            >
                <h2 class="text-skin-base font-bold mb-3 text-[clamp(16px,4vw,20px)]">{t('content.tableofcontents')}</h2>
                {
                    toc.map((heading) => (
                        <li class="pl-5">
                            <a href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                    ))
                }
            </ul>
            <section class="content container md:w-3/4 mt-14 flex flex-col text-skin-base">
                <Content />
            </section>
        </section>
    </main>
</Layout>
