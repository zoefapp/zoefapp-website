---
export const prerender = false;
import { DEFAULT_LANG } from "../i18n/constants";
import { useRoutes } from "../i18n/utils";

const acceptLanguage = Astro.request.headers.get('accept-language')?.substring(0, 2);
let language = acceptLanguage ?? DEFAULT_LANG;

let routes = useRoutes(language);

// by default redirect to the localized version of the passenger page
// return Astro.redirect(`${routes("passenger")}`);

// TODO: if the page exists as one of the keys, then redirect to the correct language 

// Let's return the user /en first as default language
---

<html>
    <head>
        {routes("passenger")}
        <!-- <meta http-equiv="refresh" content={`0;url=${routes("passenger")}`} /> -->
    </head>
</html>
