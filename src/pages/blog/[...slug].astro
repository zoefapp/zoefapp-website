---
import { getCollection, z } from "astro:content";
import type { Blog } from "~/content/config";
export const prerender = true;

interface BlogEntry {
    id: string;
    body: string;
    render: () => Promise<any>;
    slug: string;
    data: Blog;
}

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
    const blogEntries: BlogEntry[] = await getCollection("blog", ({ data }) => {
        return true;
    });
    return blogEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: {
            entry,
            translations: blogEntries
                .filter(
                    (e) =>
                        e.data.translationCode == entry.data.translationCode &&
                        e.slug != entry.slug,
                )
                .map((e) => "/blog/" + e.slug),
        },
    }));
}
// 2. For your template, you can get the entry directly from the prop
const { entry, translations } = Astro.props;
const { Content } = await entry.render();
---

<h1>{entry.data.title}</h1>
<Content />

<ul>
    {
        translations.map((slug) => (
            <li>
                <a href={slug}>{slug}</a>
            </li>
        ))
    }
</ul>
