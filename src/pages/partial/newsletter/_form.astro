---
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";
import { getLanguage, useTranslations } from "~/i18n/utils";
import Loading from "~/components/ui/Loading.astro";

export const partial = true;
export const prerender = false;

const t = useTranslations(getLanguage(Astro))

---

<form hx-post="/partial/newsletter" hx-swap="outerHTML" class="flex flex-col sm:flex-row gap-4">
    <Input placeholder={t('newsletter.email.placeholder')} required type="email" name="email" />
    <Button type="submit" variant="orange" data-hx-disabled-elt="this">{t('newsletter.subscribe')}</Button>
    <Loading></Loading>
</form>