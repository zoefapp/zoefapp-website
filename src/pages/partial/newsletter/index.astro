---
export const partial = true;
export const prerender = false;
import { HttpWebsiteClient } from "~/api/client/client";
import { ClientFetchHttpService } from "~/api/client/lib/client";
import { NewsletterSignupBody } from "~/api/client/modules/website/api";
import { getLanguage, useTranslations } from "~/i18n/utils";
import NewsletterForm from "./_form.astro";

/*
 Verification steps:
  - check domain name on spam lists 
  - check domain name on one of those mailinator lists 
  - check domain name on email blacklists
  - check domain name on email reputation
  - check domain name if exists and has MX records 
*/

let status: "form" | "subscribed" | "error" = "form";

let type = "NEWSLETTER";

let email = "";
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();

    email = formData.get("email")?.valueOf().toString() ?? "";
    let newsletter = formData.get("newsletter")?.valueOf().toString() ?? "NEWSLETTER";

    let postBody = NewsletterSignupBody.safeParse({
        email,
        newsletter,
    });

    type = newsletter

    if (postBody.success) {
        try {
            let baseUrl = import.meta.env.ZOEF_API_BASEURL;
            let api = new HttpWebsiteClient(baseUrl, new ClientFetchHttpService());
            await api.signupNewsletter(postBody.data);

            status = "subscribed";
        } catch (e) {
            console.error(e);
            status = "error";
        }
    } else {
        console.log(postBody.error);
        status = "error";
    }
} else {
    status = "form";
}

const t = useTranslations(getLanguage(Astro));
---

{status == "subscribed" && <p>{t("newsletter.subscribed")}</p>}
{status == "error" && <p>{t("newsletter.error")}</p>}
{status != "form" && <NewsletterForm type={type} email={email} />}
