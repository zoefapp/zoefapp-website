---
export const partial = true
export const prerender = false
import NewsletterForm from './_form.astro';
import {getLanguage} from '~/i18n/utils';

/*
 Verification steps:
  - check domain name on spam lists 
  - check domain name on one of those mailinator lists 
  - check domain name on email blacklists
  - check domain name on email reputation
  - check domain name if exists and has MX records 
*/

let status: "form" | "subscribed" | "error" = "form";

let email = ''
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    email = formData.get("email")?.valueOf().toString() ?? "";
    const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (validEmail) {
        status = "subscribed";
    } else {
        status = "error";
    }
} else {
    status = "form";
}


console.log(Astro.request.headers)
console.log(getLanguage(Astro))
---

{status == 'subscribed' && <p>Thank you for subscribing. We have sent an to confirm to {email}</p>}
{status == 'error' && <p>Failed to subscribe</p>}
{status == 'form' && <NewsletterForm></NewsletterForm>}
