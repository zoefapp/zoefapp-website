---
export const partial = true;
export const prerender = false;
import SingupForm from "./_form.astro";
import { getLanguage } from "~/i18n/utils";

let status: "form" | "success" | "error" = "form";

let email = "";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    email = formData.get("email")?.valueOf().toString() ?? "";
    const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (validEmail) {
        status = "success";
    } else {
        status = "error";
    }
} else {
    status = "form";
}
---

{status == "success" && <p>Thank you for subscribing. We have sent an to confirm to {email}</p>}
{status == "error" && <p>Failed to subscribe</p>}
{status == "form" && <SingupForm />}
