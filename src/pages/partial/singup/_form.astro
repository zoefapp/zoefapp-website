---
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";
---

<form hx-post="/partial/signup" hx-swap="outerHTML" class="flex flex-col sm:flex-row gap-4">
    <Input placeholder="Enter your email" required type="email" name="email" value="a@b.c" />
    <Button type="submit" variant="orange">Sign Up</Button>
</form>
