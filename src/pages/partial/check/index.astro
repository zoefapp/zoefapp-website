---
export const partial = true;
export const prerender = false;
import { HttpEligibilityClient } from "~/api/client/client";
import { ClientFetchHttpService } from "~/api/client/lib/client";
import { EligiblityCheck } from "~/api/client/modules/eligibility/model";
import { Eligibilty } from "~/api/client/modules/eligibility/model";
import Button from "~/components/ui/Button.astro";
import LinkButton from "~/components/ui/LinkButton.astro";
import { getLanguage, useTranslations } from "~/i18n/utils";

const lang = getLanguage(Astro);
const t = useTranslations(lang);

let eligible: Eligibilty | "problem" | undefined

// function wait(ms: number) : Promise<void> {
//     return new Promise((resolve) => {
//         setTimeout(resolve, ms)
//     })
// }

// await wait(1000)

try {
    let input = EligiblityCheck.parse({
        departure: Astro.url.searchParams.get("departure"),
        destination: Astro.url.searchParams.get("arrival"),
        departureTime: Astro.url.searchParams.get("date"),
    });
    let baseUrl = import.meta.env.ZOEF_API_BASEURL;

    let api = new HttpEligibilityClient(baseUrl, new ClientFetchHttpService());

    let trips = await api.determineEligibility(input);

    eligible ??= trips.find((t) => t.eligible.outcome === "probably")?.eligible;
    eligible ??= trips.find((t) => t.eligible.outcome === "maybe")?.eligible;
    eligible ??= trips.find((t) => t.eligible.outcome === "probably_not")?.eligible;

    eligible ??= {
        outcome: "undetermined",
    };
} catch (e: any) {
    console.error("Problem with eligibility check", e);
    eligible = "problem";
}
---

<div>
    {eligible === "problem" && <p>{t("compensation.result.problem")}</p>}
    {eligible !== "problem" && eligible?.outcome === "probably" && <p>{t("compensation.result.probably")}</p>}
    {eligible !== "problem" && eligible?.outcome === "undetermined" && <p>{t("compensation.result.undetermined")}</p>}
    {eligible !== "problem" && eligible?.outcome === "maybe" && <p>{t("compensation.result.maybe")}</p>}
    {eligible !== "problem" && eligible?.outcome === "probably_not" && <p>{t("compensation.result.probably_not")}</p>}

    <Button variant="gray" onclick="closeCompensationCheckModal()">Gegevens aanpassen</Button>

    <LinkButton target="_blank" variant="orange" href="https://get.zoef.app/?source=claimcheckwebsite"
        >Download de app</LinkButton
    >
</div>
