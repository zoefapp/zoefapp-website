---
export const partial = true;
export const prerender = false;
import SingupForm from "./_form.astro";
import { getLanguage } from "~/i18n/utils";

let status: "form" | "success" | "error" = "form";

let email = "";

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    email = formData.get("email")?.valueOf().toString() ?? "";
    const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    await new Promise((resolve) => setTimeout(resolve, 2000));
    if (validEmail) {
        status = "success";
    } else {
        status = "error";
    }
} else {
    status = "form";
}
---

{
    status == "success" && (
        <p class="font-bold">Thank you for signing up. We have sent you an confirmation email to {email}!</p>
    )
}
{status == "error" && <p class="font-bold text-red-500">Failed to sign up. Email is not valid.</p>}
{status == "form" && <SingupForm />}
