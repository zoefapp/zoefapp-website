---
interface Props {
    type: string,
    email?: string
}

import Button from "~/components/ui/Button.astro";
import Input from "~/components/ui/Input.astro";
import Loading from "~/components/ui/Loading.astro";
import { getLanguage, useTranslations } from "~/i18n/utils";

export const partial = true;
export const prerender = false; // for multi-language support


const lang = getLanguage(Astro)

const t = useTranslations(lang)

---

<form hx-post="/partial/signup" hx-swap="outerHTML" class="flex flex-col sm:flex-row gap-4">
    <Input placeholder={t('productsignup.email.placeholder')} required type="email" name="email" value={Astro.props.email} className="grow" />
    <input type="hidden" name="signup" value={Astro.props.type} />
    <Button type="submit" variant="orange" data-hx-disabled-elt="this">{t('productsignup.subscribe')}</Button>
    <Loading></Loading>
</form>