---
import { getBlogPaths } from '~/lib/blog';
import BlogPage from '~/page-templates/BlogPage.astro';
import BlogTagPage from '~/page-templates/BlogTagPage.astro';

export const prerender = true;
export const getStaticPaths = getBlogPaths.bind(null, 'nl');

const { blog, tag } = Astro.props;
---

{blog && <BlogPage blog={blog}></BlogPage>}
{tag && <BlogTagPage tag={tag}></BlogTagPage>}