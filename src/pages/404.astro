---
export const prerender = false;

interface Props {
    type: "privacy" | "terms";
}

import Layout from "~/layouts/Layout.astro";
import { getLanguage, useTranslations } from "~/i18n/utils";
import { getPageContent } from "~/lib/page";

const lang = getLanguage(Astro);
const t = useTranslations(lang);

let pageContent = await getPageContent(lang, "notfound");

const { Content } = await pageContent.render();
---

<Layout>
    <main class="theme-passenger">
        <section class="flex flex-col relative w-full">
            <section
                class="container gap-8 font-bold flex flex-col md:flex-row md:items-center justify-between pt-20 pb-8"
            >
                <aside class="gap-3 flex flex-col md:w-1/2">
                    <h1 class="text-[clamp(1.5rem,4vw,2.5rem)] text-skin-base font-bold">{pageContent.data.title}</h1>
                    {
                        pageContent.data.lastUpdated && (
                            <p class="text-[15px] font-bold">
                                {t("content.lastupdated")} {pageContent.data.lastUpdated.toLocaleDateString()}
                            </p>
                        )
                    }
                </aside>
            </section>
            <div class="absolute inset-0 bg-skin-gradient -z-10 rounded-b-3xl md:rounded-b-2xl"></div>
        </section>

        <section class="content container md:w-3/4 mt-14 flex flex-col text-skin-base">
            <Content />
        </section>
    </main>
</Layout>
