    <div class="grid gap-4">
        <h3 class="text-xl font-semibold">Your Ticket</h3>
        <div
            id="drop-area"
            class="flex justify-center items-center rounded-lg border border-dashed border-skin-secondary px-6 py-10 aspect-[4/1]"
        >
            <div class="text-center">
                <svg
                    class="mx-auto h-16 w-16 text-skin-secondary"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        fill-rule="evenodd"
                        d="M1.5 6a2.25 2.25 0 012.25-2.25h16.5A2.25 2.25 0 0122.5 6v12a2.25 2.25 0 01-2.25 2.25H3.75A2.25 2.25 0 011.5 18V6zM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0021 18v-1.94l-2.69-2.689a1.5 1.5 0 00-2.12 0l-.88.879.97.97a.75.75 0 11-1.06 1.06l-5.16-5.159a1.5 1.5 0 00-2.12 0L3 16.061zm10.125-7.81a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0z"
                        clip-rule="evenodd"
                    >
                    </path>
                </svg>
                <div class="mt-4 flex text-sm leading-6 text-gray-600">
                    <label for="file-upload" class="font-bold hover:underline cursor-pointer">
                        <span>Upload a file</span>
                        <input id="file-upload" name="file-upload" type="file" class="sr-only" />
                    </label>
                    <p class="pl-1">or drag and drop</p>
                </div>
                <p class="text-xs leading-5 text-gray-600">PNG, JPG, GIF up to 10MB</p>
            </div>
        </div>
    </div>
</fieldset>

<script>
    const dropArea = document.querySelector("#drop-area") as HTMLElement;
    const fileInput = document.querySelector("#file-upload") as HTMLInputElement;
    if (dropArea) {
        dropArea.addEventListener("drop", (event: DragEvent) => {
            event.preventDefault();
            if (event.dataTransfer) {
                const { files } = event.dataTransfer;
                if (files) {
                    fileInput.files = files;
                    fileInput.dispatchEvent(new Event("change"));
                    console.log(files[0], "from file input");
                }
            }
        });
    }
</script>
