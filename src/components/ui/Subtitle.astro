---
interface Props extends HTMLAttributes<"h3"> {
    className?: ClassValue;
    variant: "secondary" | "default";
}
const { className, variant = "default" } = Astro.props;
import type { HTMLAttributes } from "astro/types";
import type { ClassValue } from "clsx";
import { cn } from "~/lib/utils";

type SubtitleVariants = {
    [key in "default" | "secondary"]: string;
};
const variants: SubtitleVariants = {
    default: "text-[clamp(1.3rem,2vw,1.5rem)] text-black font-semibold",
    secondary: "text-[clamp(22px,4vw,26px)] text-skin-secondary font-bold",
};
---

<h2 class={cn("", variants[variant], className)} {...Astro.props}>
    <slot />
</h2>
