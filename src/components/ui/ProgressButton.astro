---
interface Props {
    type: "cancel" | "confirm";
}
const { type } = Astro.props;
import { Icon } from "astro-icon/components";
---

{
    type === "cancel" && (
        <button class="flex gap-2 font-bold text-orange-light bg-white items-center px-4 py-3 hover:bg-orange-light hover:text-white transition-colors rounded-lg border border-orange-light">
            <Icon name="lucide:x" class="w-6 h-6" />
            <p>Dit was niet mijn reis</p>
        </button>
    )
}

{
    type === "confirm" && (
        <button class="flex gap-2 font-bold hover:text-orange-light items-center px-4 py-3 bg-orange-light hover:bg-white text-white transition-colors rounded-lg border border-orange-light">
            <Icon name="lucide:check" class="w-6 h-6" />
            <p>Bevestig deze reis</p>
        </button>
    )
}
