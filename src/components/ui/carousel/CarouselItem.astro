---
interface Props {
    id: string;
}
const { id } = Astro.props;
---

<div
    class={`${id}-item p-5 flex flex-col gap-4 bg-white rounded-xl min-w-[calc(100vw/1.2)] md:min-w-[calc(100vw/2.5)] lg:min-w-[calc(100vw/2.3)] xl:min-w-[calc(1400px/2.4)] aspect-video snap-center`}
>
    <slot />
</div>
