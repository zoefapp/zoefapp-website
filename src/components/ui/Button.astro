---
import type { HTMLAttributes } from "astro/types";
interface Props extends Omit<HTMLAttributes<"button">, "class"> {
    variant?: "orange" | "default";
    className?: ClassValue;
}
const { variant = "default", className, ...props } = Astro.props;
import { cn } from "~/lib/utils";
import type { ClassValue } from "clsx";
import { cx } from "class-variance-authority";

type ButtonVariants = {
    [key in "default" | "orange"]: string;
};

const buttonVariants: ButtonVariants = {
    default: cx("bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-md px-3 py-2 text-sm font-semibold w-full"),
    orange: cx(
        "bg-orange-light hover:bg-orange-light/80 transition-colors duration-300 text-orange-dark w-max rounded-md px-4 py-3 text-sm font-bold"
    ),
};
---

<button class={cn(buttonVariants[variant], className)} {...props}>
    <slot />
</button>
