---
let { name, placeholder, className, id } = Astro.props;
import { cn } from "~/lib/utils";
import { Icon } from "astro-icon/components";
---

<script>
    import Alpine from "alpinejs";

    import unidecode from "unidecode";
    import { Trie } from "~/lib/trie.ts";

    interface Station {
        name: string;
        id: string;
    }

    let trie = new Trie();
    fetch("/resources/stations.nl.trie.json")
        .then((res) => res.json())
        .then((data) => new Trie(data))
        .then((newTrie) => {
            trie = newTrie;
        });

    Alpine.data(
        "stationSelector",
        () =>
            ({
                station: null,
                open: false,
                searchInput: "",
                selectedIndex: -1,
                matches: [],
                search(input: string) {
                    this.open = true;
                    this.selectedIndex = 0;

                    input = input.trim();
                    input = unidecode(input.toLowerCase());
                    
                    if (!input || input.length < 2) {
                        this.matches = [];
                        return;
                    }

                    this.matches = trie
                        .search(input.split(" "))
                        .filter((r) => {
                            return r.values.find((v) => v > 0);
                        })
                        .map((match) => {
                            console.log(match);
                            return {
                                id: match.values.find((v) => v > 0),
                                name: match.key,
                            };
                        });
                },
                nextResult() {
                    if (this.selectedIndex < this.matches.length - 1) {
                        this.selectedIndex = this.selectedIndex + 1;
                    }
                },
                previousResult() {
                    if (this.selectedIndex > 0) {
                        this.selectedIndex = this.selectedIndex - 1;
                    }
                },
                select(station: Station) {
                    if (station) {
                        this.station = station;
                        this.searchInput = station.name;
                        this.selectedIndex = this.matches.indexOf(station);
                    }
                    this.open = false;
                },
                onblur() {
                    this.open = false;
                    if (!this.station) {
                        this.searchInput = "";
                    } else {
                        this.searchInput = this.station.name;
                    }
                },
            }) as any
    );
</script>

<div class={cn("stationSelector", className)} x-data="stationSelector">
    <input type="hidden" name={name} :value="station?.id" />
    <div class="relative w-full h-11">
        <Icon class="absolute top-1/2 left-2 text-gray-400 -translate-y-1/2 w-5 h-5 z-10" name="lucide:train-front" />
        <input
            type="text"
            autocomplete="off"
            id={id}
            spellcheck="false"
            @focus="search($event.target.value)"
            @keydown.down.prevent="nextResult()"
            @keydown.up.prevent="previousResult()"
            @keydown.enter.prevent="select(matches[selectedIndex])"
            @input="search($event.target.value)"
            x-model="searchInput"
            @blur="onblur()"
            class="absolute inset-0 w-full p-4 pl-10 border rounded-md"
            placeholder={placeholder}
        />
    </div>
    <div class="absolute z-10 w-full bg-white border rounded-md shadow-md" x-show="open && matches.length > 0">
        <ul>
            <template x-for="(result, index) in matches" :key="result.id">
                <li
                    class="p-2 hover:bg-gray-100"
                    :class="{'bg-gray-100': selectedIndex == index}"
                    @mousedown="select(result)"
                    x-text="result.name"
                >
                </li>
            </template>
        </ul>
    </div>
</div>
