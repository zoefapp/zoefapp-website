---
export interface Astro {
    name: string;
    placeholder: string;
    id: string;
    "x-model"?: string;
}
let { name, placeholder, id } = Astro.props;
import { Icon } from "astro-icon/components";
---

<script>
    import flatpickr from "flatpickr";
    // import { Dutch } from "flatpickr/dist/l10n/nl.js";
    import "flatpickr/dist/themes/dark.css";

    import Alpine from "alpinejs";
    Alpine.data("flatpickerData", () => {
        let data:any; // ugly hack around the 'this' problem
        return {
            formattedDate: new Date(Date.now() - 3600 * 1000).toISOString(),
            chosenDate: new Date(Date.now() - 3600 * 1000),
            init() {
                flatpickr(this.$refs.datetimewidget, this.settings);
                data = this;
                this.chosenDate = new Date(Date.now() - 3600 * 1000);
            },
            settings: {
                wrap: true,
                enableTime: true,
                time_24hr: true,
                minDate: new Date(Date.now() - 90 * 86400 * 1000),
                maxDate: new Date(Date.now() - 10 * 60 * 1000),
                dateFormat: "d-m-Y H:i",
                defaultDate: new Date(Date.now() - 3600 * 1000),
                onChange(dates: Date[]) {
                    let date = dates[0];
                    console.log("on change: ", this);
                    if (date) {
                        data.formattedDate = date.toISOString();
                        data.chosenDate = date;
                    } else {
                        data.formattedDate = "";
                        this.chosenDate = null;
                    }
                },
            },
        };
    });
</script>

<div
    x-data="flatpickerData()"
    x-ref="datetimewidget"
    class="flatpickr"
    x-modelable="chosenDate"
    x-model={Astro.props["x-model"]}
>
    <input type="hidden" name={name} :value="formattedDate" />
    <div class="relative h-11">
        <Icon name="lucide:clock" class="absolute left-2 top-1/2 -translate-y-1/2 z-10 text-gray-400 w-5 h-5" />
        <input
            x-ref="datetime"
            type="text"
            id={id}
            data-input
            placeholder={placeholder}
            class="absolute inset-0 w-full p-4 pl-10 border rounded-md"
        />
    </div>
</div>
