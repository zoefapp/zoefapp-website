---
interface Props {
    name: string;
    title: string;
    content: string;
}
import { Icon } from "astro-icon/components";

const { name, title, content } = Astro.props;
---

<>
    <div data-state="inactive" class={`${name} flex group flex-col justify-center data-[state=active]:space-y-3`}>
        <button class="flex justify-between text-start w-full font-bold">
            <h2 class="mr-6">{title}</h2>
            <div class="relative w-6 h-6">
                <Icon
                    name="lucide:minus"
                    class="absolute text-orange-light left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 shrink-0 w-6 h-6 group-data-[state=inactive]:rotate-90 group-data-[state=active]:opacity-0 transition-all duration-500"
                />
                <Icon
                    name="lucide:minus"
                    class="absolute text-orange-light left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 shrink-0 w-6 h-6"
                />
            </div>
        </button>
        <p
            class="overflow-hidden max-w-[90%] max-h-0 group-data-[state=inactive]:max-h-0 group-data-[state=active]:max-h-96 transition-all group-data-[state=active]:duration-300"
        >
            {content}
        </p>
    </div>
    <div class="border-b w-full"></div>
</>
