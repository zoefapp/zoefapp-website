---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLanguage, translations } from "~/i18n/utils";
import Subtitle from "./ui/Subtitle.astro";

const lang = getLanguage(Astro)
const t = translations(Astro);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/content/howitworks/*/*.{jpeg,jpg,png,gif}');

let howitworksCollection = await getCollection("howitworks", entry => entry.id.startsWith(lang))
howitworksCollection.sort((a, b) => a.data.order - b.data.order)

function getImage(path: string) {
    let imagePath = `/src/content/howitworks/${lang}/${path}`
    return images[imagePath]()
}

---

<section class="container py-[60px]">
    <section class="flex flex-col gap-6 w-[90%] mx-auto">
        <section class="flex flex-col lg:flex-row-reverse gap-10 items-center" data-aos="fade-bottom" data-aos-duration="1000" data-aos-delay="200">
            <Subtitle variant="secondary" className="font-bold self-start lg:hidden">
                {t("howzoefworks.title")}
            </Subtitle>
            <aside class="images-container flex w-full lg:w-1/2 overflow-clip">
                {
                    howitworksCollection.map((item, index) => (
                        <div
                            id={item.id.replaceAll(/\W/g, '-').toLowerCase()}
                            data-state={index == 0 ? 'active' : 'inactive'}
                            class="divs sm:max-w-lg lg:max-w-full mx-auto fill-mode-backwards data-[state=active]:animate-in data-[state=active]:duration-1000 data-[state=active]:fade-in data-[state=inactive]:hidden overflow-clip"
                        >
                            <Image
                                src={getImage(item.data.image)}
                                alt="How Zoef Works"
                                format="avif"
                                loading="lazy"
                                decoding="async"
                                class="mx-auto"
                                width={700}
                            />
                        </div>
                    ))
                }
            </aside>
            <aside class="swipe-container flex lg:flex-col w-full lg:w-1/2 overflow-x-hidden lg:overflow-x-auto py-4">
                <Subtitle variant="secondary" className="font-bold max-lg:hidden py-4">
                    {t("howzoefworks.title")}
                </Subtitle>
                {
                    howitworksCollection.map((item, index) => (
                        <button
                            id={item.id.replaceAll(/\W/g, '-').toUpperCase()}
                            data-state={index == 0 ? 'active' : 'inactive'}
                            class="btns flex flex-col gap-2 py-5 px-8 border-b lg:border-l-2 lg:border-b-0 border-amber-300 data-[state=inactive]:border-blue-200 transition-colors min-w-[calc(75vw)] lg:min-w-0 w-full text-start data-[state=inactive]:opacity-50"
                        >
                            <h4 class="font-bold text-lg">{item.data.title}</h4>
                            <p class="text-balance">{item.data.description}</p>
                        </button>
                    ))
                }
            </aside>
        </section>
    </section>
</section>

<script is:inline>
    const btns = document.querySelectorAll(".btns");
    const divs = document.querySelectorAll(".divs");
    btns.forEach((btn) => {
        btn.addEventListener("click", () => {
            const correspondingDiv = document.getElementById(btn.id.toLowerCase());
            const correspondingButton = document.getElementById(btn.id);
            btns.forEach((btn) => {
                btn.setAttribute("data-state", "inactive");
                if (btn === correspondingButton) {
                    btn.setAttribute("data-state", "active");
                }
            });
            divs.forEach((div) => {
                div.setAttribute("data-state", "inactive");
                if (div === correspondingDiv) {
                    div.setAttribute("data-state", "active");
                }
            });
        });
    });

    // Swipe
    let touchStartXX = 0;
    let touchEndXX = 0;

    document.querySelector(".swipe-container").addEventListener(
        "touchstart",
        (e) => {
            touchStartXX = e.touches[0].clientX;
        },
        { passive: true }
    );

    document.querySelector(".swipe-container").addEventListener("touchend", (e) => {
        touchEndXX = e.changedTouches[0].clientX;
        if (window.innerWidth < 1024) {
            swipeHandler();
        }
    });
    document.querySelector(".images-container").addEventListener(
        "touchstart",
        (e) => {
            touchStartXX = e.touches[0].clientX;
        },
        { passive: true }
    );

    document.querySelector(".images-container").addEventListener("touchend", (e) => {
        touchEndXX = e.changedTouches[0].clientX;
        if (window.innerWidth < 1024) {
            swipeHandler();
        }
    });
    const swipeHandler = () => {
        const container = document.querySelector(".swipe-container");
        const threshold = 50;
        const delta = touchStartXX - touchEndXX;
        // Next
        if (delta > threshold) {
            let currentBtn = document.querySelector(".btns[data-state=active]");
            let currentImage = document.getElementById(currentBtn.id.toLowerCase());
            if (currentBtn.nextElementSibling && currentBtn.nextElementSibling.hasAttribute("data-state")) {
                container.scrollBy({
                    left: window.innerWidth * 0.75,
                    behavior: "smooth",
                });
                // Button
                currentBtn.setAttribute("data-state", "inactive");
                currentBtn.nextElementSibling.setAttribute("data-state", "active");
                currentBtn = currentBtn.nextElementSibling;
                // Images
                currentImage.setAttribute("data-state", "inactive");
                currentImage.nextElementSibling.setAttribute("data-state", "active");
                currentImage = currentImage.nextElementSibling;
            }
        }
        // Previous
        if (delta < -threshold) {
            let currentBtn = document.querySelector(".btns[data-state=active]");
            let currentImage = document.getElementById(currentBtn.id.toLowerCase());
            if (currentBtn.previousElementSibling.hasAttribute("data-state")) {
                container.scrollBy({
                    left: -window.innerWidth * 0.75,
                    behavior: "smooth",
                });
                // Buttons
                currentBtn.setAttribute("data-state", "inactive");
                currentBtn.previousElementSibling.setAttribute("data-state", "active");
                currentBtn = currentBtn.previousElementSibling;
                // Images
                currentImage.setAttribute("data-state", "inactive");
                currentImage.previousElementSibling.setAttribute("data-state", "active");
                currentImage = currentImage.previousElementSibling;
            }
        }
    };
</script>
