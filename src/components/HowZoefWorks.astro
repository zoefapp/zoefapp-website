---
// Utils
import { useT } from "~/i18n/utils";
const t = useT(Astro);
import { Image } from "astro:assets";
// Images
import HowZoefWorksImage from "~/assets/images/how-zoef-works.png";
import Subtitle from "./ui/Subtitle.astro";

const HowZoefWorksData = {
    buttons: [
        {
            id: "FIRST",
            initialState: "active",
            title: t("howzoefworks.first.title"),
            description: t("howzoefworks.first.description"),
        },
        {
            id: "SECOND",
            initialState: "inactive",
            title: t("howzoefworks.second.title"),
            description: t("howzoefworks.second.description"),
        },
        {
            id: "THIRD",
            initialState: "inactive",
            title: t("howzoefworks.third.title"),
            description: t("howzoefworks.third.description"),
        },
    ],
    images: [
        {
            id: "first",
            initialState: "active",
            image: HowZoefWorksImage,
        },
        {
            id: "second",
            initialState: "inactive",
            image: HowZoefWorksImage,
        },
        {
            id: "third",
            initialState: "inactive",
            image: HowZoefWorksImage,
        },
    ],
};
---

<section class="container py-24">
    <section class="flex flex-col gap-6 w-[90%] mx-auto">
        <Subtitle variant="secondary" className="font-bold">{t("howzoefworks.title")}</Subtitle>
        <section class="flex flex-col-reverse lg:flex-row gap-10 items-center">
            <aside class="flex lg:flex-col w-full lg:w-1/2 overflow-x-scroll lg:overflow-x-auto py-4">
                {
                    HowZoefWorksData.buttons.map((button) => (
                        <button
                            id={button.id}
                            data-state={button.initialState}
                            class="btns flex flex-col gap-3 py-8 lg:py-4 px-4 border-b lg:border-l lg:border-b-0 border-amber-300 h-max data-[state=inactive]:border-blue-200 transition-colors min-w-[75vw] lg:min-w-0 w-full text-start data-[state=inactive]:opacity-50"
                        >
                            <h4 class="font-bold text-lg">{button.title}</h4>
                            <p class="text-balance">{button.description}</p>
                        </button>
                    ))
                }
            </aside>
            <aside class="flex w-full lg:w-1/2 overflow-clip">
                <div
                    id="first"
                    data-state="active"
                    class="divs sm:max-w-lg lg:max-w-full mx-auto fill-mode-backwards data-[state=active]:animate-in data-[state=active]:duration-1000 data-[state=active]:fade-in data-[state=active]:slide-in-from-right-32 data-[state=inactive]:hidden overflow-clip"
                >
                    <Image src={HowZoefWorksImage} alt="How Zoef Works Image" class="mx-auto" />
                </div>
                <div
                    id="second"
                    data-state="inactive"
                    class="divs sm:max-w-lg lg:max-w-full mx-auto fill-mode-backwards data-[state=active]:animate-in data-[state=active]:duration-1000 data-[state=active]:fade-in data-[state=active]:slide-in-from-right-32 data-[state=inactive]:hidden overflow-clip"
                >
                    <Image src={HowZoefWorksImage} alt="How Zoef Works Image" class="mx-auto" />
                </div>
                <div
                    id="third"
                    data-state="inactive"
                    class="divs sm:max-w-lg lg:max-w-full mx-auto fill-mode-backwards data-[state=active]:animate-in data-[state=active]:duration-1000 data-[state=active]:fade-in data-[state=active]:slide-in-from-right-32 data-[state=inactive]:hidden overflow-clip"
                >
                    <Image src={HowZoefWorksImage} alt="How Zoef Works Image" class="mx-auto" />
                </div>
            </aside>
        </section>
    </section>
</section>

<script is:inline>
    const btns = document.querySelectorAll(".btns");
    const divs = document.querySelectorAll(".divs");
    btns.forEach((btn) => {
        btn.addEventListener("click", () => {
            const correspondingDiv = document.querySelector(`#${btn.id.toLowerCase()}`);
            const correspondingButton = document.getElementById(btn.id);
            btns.forEach((btn) => {
                btn.setAttribute("data-state", "inactive");
                if (btn === correspondingButton) {
                    btn.setAttribute("data-state", "active");
                }
            });
            divs.forEach((div) => {
                div.setAttribute("data-state", "inactive");
                if (div === correspondingDiv) {
                    div.setAttribute("data-state", "active");
                }
            });
        });
    });
</script>
