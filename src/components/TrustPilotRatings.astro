---
interface Props {
    data: {
        review_count: number;
        star_count: number;
        review_market: string;
    };
}
// Utils
import { Image } from "astro:assets";
// Images
import TrustPilotStar from "~/assets/images/trustpilot-star.svg";
import AppStoreLogo from "~/assets/images/appstore-icon.png";
const { data } = Astro.props;
---

<section class="flex flex-wrap gap-4">
    <aside class="flex gap-4">
        <p class="font-bold">Excellent</p>
        <div class="flex items-center gap-1">
            {
                Array.from({ length: data.star_count }, (_, i) => (
                    <div class="w-7 rounded-md bg-amber-500 p-1">
                        <Image src={TrustPilotStar} alt="TrustPilot Star" loading={"eager"} decoding={"async"} />
                    </div>
                ))
            }
        </div>
    </aside>
    <aside>
        <p class="inline-flex gap-2 items-center">
            <strong>{data.review_count}</strong> reviews on
            <Image class="w-6 h-6" src={AppStoreLogo} alt="App Store" loading={"eager"} decoding={"async"} />
            <strong> {data.review_market}</strong>
        </p>
    </aside>
</section>
