---
interface Props {
    blog: BlogContentEntry;
}
const { blog } = Astro.props;
// Utils
import type { BlogContentEntry } from "~/lib/blog";
import { getBlogUrl } from "~/lib/blog";
import { getLanguage } from "~/i18n/utils";
import { Image } from "astro:assets";
const lang = getLanguage(Astro);
// Images
import BlogPlaceholderImage from "~/assets/images/blog-placeholder.png";
---

<a href={getBlogUrl(lang, blog)} class="text-skin-base">
    <section class="flex flex-col gap-4 w-full max-w-xl mx-auto group">
        <div class="relative">
            <p
                class="absolute capitalize font-bold top-5 left-5 px-5 py-2 text-xs bg-white text-[#66AE6E] rounded-[12px]"
            >
                {blog.data.tags.join(", ")}
            </p>
            <Image
                loading={"lazy"}
                src={BlogPlaceholderImage}
                alt="Blog Placeholder"
                class="rounded-xl"
                format="avif"
                decoding="async"
                quality={50}
                width={576}
            />
        </div>
        <div class="bg-white rounded-2xl max-lg:-translate-y-8 max-lg:px-5 max-lg:py-3 max-lg:w-4/5 max-lg:mx-auto">
            <p class="opacity-60 text-xs">
                {
                    blog.data.date.toLocaleDateString(lang, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })
                }
            </p>
            <p class="font-bold text-lg text-pretty group-hover:text-orange-light transition-colors leading-tight">
                {blog.data.title}
            </p>
        </div>
    </section>
</a>
