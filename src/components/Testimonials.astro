---
import { getTestimonials, type Testimonial } from "~/lib/testimonial";
// Utils
import { getLanguage, translations, useTranslations } from "~/i18n/utils";
const lang = getLanguage(Astro);
const t = useTranslations(lang);
const testimonials = await getTestimonials("passenger", lang);
import { Image } from "astro:assets";
// Components
import Carousel from "./ui/carousel/Carousel.astro";
import CarouselItem from "./ui/carousel/CarouselItem.astro";
// Icons
import StarIcon from "~/assets/images/icons/star-icon.png";
import Subtitle from "./ui/Subtitle.astro";
import EuroIconGreen from "~/assets/images/icons/euro-icon-green.png";
import { Icon } from "astro-icon/components";
---

<section class="container bg-gray-50 rounded-2xl p-5 md:px-10 lg:px-20 py-[60px]">
    <Carousel id="testimonials" title={t("testimonials.title")}>
        {
            testimonials.map((item: Testimonial) => (
                <CarouselItem id="testimonials">
                    <div class="flex gap-5 items-center">
                        <Image
                            src={item.avatar}
                            alt="Avatar"
                            width={110}
                            height={110}
                            class="rounded-xl ring-1 ring-avatar-border p-1"
                            loading={"lazy"}
                            decoding={"async"}
                            format={"avif"}
                            quality={80}
                        />
                        <div class="flex flex-col gap-2">
                            <h2 class="font-bold text-[18px]">{item.person}</h2>
                            <div class="flex gap-1.5 items-center">
                                {Array.from({ length: item.stars }, (_, __) => (
                                    <Image
                                        width={32}
                                        height={32}
                                        class="w-4 h-4 lg:w-6 lg:h-6"
                                        format="avif"
                                        loading="lazy"
                                        decoding="async"
                                        src={StarIcon}
                                        alt="Star Icon"
                                        quality={80}
                                    />
                                ))}
                            </div>
                        </div>
                    </div>
                    <aside class="flex flex-col gap-5">
                        <p>“{item.testimonial}”</p>
                        <div class="flex items-center gap-2 mt-10">
                            <Image src={EuroIconGreen} alt="Euro Icon" width={28} />
                            <div class="flex items-center gap-2">
                                <p class="text-2xl font-extrabold">2524</p>
                                <p> terug gestort met Zoef</p>
                            </div>
                        </div>
                    </aside>
                </CarouselItem>
            ))
        }
    </Carousel>
</section>
