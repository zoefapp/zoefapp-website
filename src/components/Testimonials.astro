---
interface Props {
    data: Testimonial[];
}
import type { Testimonial } from "~/lib/testimonial";
const { data } = Astro.props;
// Utils
import { getLangFromUrl, useT } from "~/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useT(Astro);
// Components
import Carousel from "./ui/Carousel.astro";
---

<section class="container bg-gray-50 rounded-2xl p-5 md:p-10 lg:p-20">
    <Carousel title={t("testimonials.title")} data={data} />
</section>
