---
import { getTestimonials, TestimonialRelevance, type TestimonialContentEntry } from "~/lib/testimonial";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getLanguage, useTranslations } from "~/i18n/utils";
import Carousel from "./ui/carousel/Carousel.astro";
import CarouselItem from "./ui/carousel/CarouselItem.astro";
import EuroIconGreen from "~/assets/images/icons/euro-icon-green.png";
import StarIcon from "~/assets/images/icons/star-icon.png";
import { resolve } from "path";
import TestimonialPlaceholderImage from "~/assets/images/testimonial-placeholder.png";

interface Props {
    relevantFor: TestimonialRelevance;
}
const lang = getLanguage(Astro);
const t = useTranslations(lang);
const testimonials = await getTestimonials(Astro.props.relevantFor, lang);

const images = import.meta.glob<{ default: ImageMetadata }>("/src/content/testimonial/*.{jpeg,jpg,png,gif}");

async function getTestimonialImage(testimonial: TestimonialContentEntry): Promise<{ default: ImageMetadata }> {
    if (!testimonial.data.avatar) {
        return { default: TestimonialPlaceholderImage };
    }

    let avatarPath = resolve("/src/content/testimonial/" + testimonial.id + "/../" + testimonial.data.avatar);
    if (images[avatarPath]) {
        return images[avatarPath]();
    }

    throw new Error(`Image not found: ${avatarPath}`);
}
---

<section class="container bg-gray-50 rounded-2xl p-8 my-[60px]">
    <Carousel id="testimonials" title={t("testimonials.title")}>
        {
            testimonials.map((item: TestimonialContentEntry) => (
                <CarouselItem id="testimonials">
                    <div class="flex gap-5 items-center">
                        <Image
                            src={getTestimonialImage(item)}
                            alt="Avatar"
                            width={110}
                            height={110}
                            class="rounded-xl ring-1 ring-avatar-border p-1"
                            loading={"lazy"}
                            decoding={"async"}
                            format={"avif"}
                            quality={100}
                        />
                        <div class="flex flex-col gap-2">
                            <h2 class="font-bold text-[18px]">{item.data.person}</h2>
                            <div class="flex gap-1.5 items-center">
                                {Array.from({ length: item.data.stars }, (_, __) => (
                                    <Image
                                        width={32}
                                        height={32}
                                        class="w-4 h-4 lg:w-6 lg:h-6"
                                        format="avif"
                                        loading="lazy"
                                        decoding="async"
                                        src={StarIcon}
                                        alt="Star Icon"
                                        quality={80}
                                    />
                                ))}
                            </div>
                        </div>
                    </div>
                    <aside class="flex flex-col gap-5">
                        <p>“{item.data.testimonial}”</p>
                        {item.data.compensation ? (
                            <div class="flex items-center gap-2 mt-10">
                                <Image src={EuroIconGreen} alt="Euro Icon" width={28} />

                                <div class="flex items-center gap-2">
                                    <p class="text-2xl font-extrabold">{item.data.compensation}</p>
                                    <p> {t("testimonials.compensation")}</p>
                                </div>
                            </div>
                        ) : (
                            ""
                        )}
                    </aside>
                </CarouselItem>
            ))
        }
    </Carousel>
</section>
