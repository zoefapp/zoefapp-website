---
import { getTestimonials, type Testimonial } from "~/lib/testimonial";
// Utils
import { getLanguage, translations, useTranslations } from "~/i18n/utils";
const lang = getLanguage(Astro);
const t = useTranslations(lang);
const testimonials = await getTestimonials("passenger", lang);
import { Image } from "astro:assets";
// Components
import Carousel from "./ui/carousel/Carousel.astro";
import CarouselItem from "./ui/carousel/CarouselItem.astro";
// Icons
import StarIcon from "~/assets/images/icons/star-icon.png";
import Subtitle from "./ui/Subtitle.astro";
---

<section class="container bg-gray-50 rounded-2xl p-5 md:p-10 lg:p-20">
    <Subtitle variant="secondary" set:html={t("testimonials.title")} />
    <Carousel id="testimonials">
        {
            testimonials.map((item: Testimonial) => (
                <CarouselItem id="testimonials">
                    <div class="flex gap-5 items-center">
                        <Image
                            src={item.avatar}
                            alt="Avatar"
                            width={110}
                            height={110}
                            class="rounded-md"
                            loading={"lazy"}
                            decoding={"async"}
                            format={"avif"}
                            quality={80}
                        />
                        <div class="flex flex-col gap-2">
                            <h2 class="font-bold">{item.person}</h2>
                            <div class="flex gap-1.5 items-center">
                                {Array.from({ length: item.stars }, (_, __) => (
                                    <Image
                                        width={16}
                                        height={16}
                                        format="avif"
                                        loading="lazy"
                                        decoding="async"
                                        src={StarIcon}
                                        alt="Star Icon"
                                        quality={80}
                                    />
                                ))}
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-col gap-5">
                        <p>{item.testimonial}</p>
                    </div>
                </CarouselItem>
            ))
        }
    </Carousel>
</section>
