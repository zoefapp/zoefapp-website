---
import { socials } from "~/lib/socials";
import Button from "../ui/Button.astro";
import { Icon } from "astro-icon/components";
---

<div class="grid sm:grid-cols-2 items-center gap-16 my-6 mx-auto max-w-4xl bg-white font-[sans-serif]">
    <div>
        <div class="content">
            <slot />
        </div>
        <div class="mt-12">
            <h2 class="text-lg font-extrabold">Email</h2>
            <ul class="mt-3">
                <li class="flex items-center">
                    <div class="bg-[#e6e6e6cf] h-10 w-10 rounded-full flex items-center justify-center shrink-0">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20px"
                            height="20px"
                            fill="#007bff"
                            viewBox="0 0 479.058 479.058"
                        >
                            <path
                                d="M434.146 59.882H44.912C20.146 59.882 0 80.028 0 104.794v269.47c0 24.766 20.146 44.912 44.912 44.912h389.234c24.766 0 44.912-20.146 44.912-44.912v-269.47c0-24.766-20.146-44.912-44.912-44.912zm0 29.941c2.034 0 3.969.422 5.738 1.159L239.529 264.631 39.173 90.982a14.902 14.902 0 0 1 5.738-1.159zm0 299.411H44.912c-8.26 0-14.971-6.71-14.971-14.971V122.615l199.778 173.141c2.822 2.441 6.316 3.655 9.81 3.655s6.988-1.213 9.81-3.655l199.778-173.141v251.649c-.001 8.26-6.711 14.97-14.971 14.97z"
                                data-original="#000000"></path>
                        </svg>
                    </div>
                    <a href="mailto:info@zoef.app" class="text-sm ml-3">
                        <small class="block">Mail</small>
                        <strong>info@zoef.app</strong>
                    </a>
                </li>
            </ul>
        </div>
        <div class="mt-12">
            <h2 class="text-lg font-extrabold">Socials</h2>
            <ul class="flex flex-col gap-3">
                {
                    socials.map((social) => (
                        <li class="flex gap-4 items-center text-[14px]">
                            <Icon name={social.icon} class="w-5 h-5" aria-label={social.text} />
                            <a class="hover:underline" href={social.url} target="_blank" rel="noopener noreferrer">
                                {social.text}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
    <form class="ml-auo space-y-4 hidden">
        <input
            type="text"
            placeholder="Name"
            class="w-full rounded-md py-3 px-4 bg-gray-100 text-sm outline-[#007bff]"
        />
        <input
            type="email"
            placeholder="Email"
            class="w-full rounded-md py-3 px-4 bg-gray-100 text-sm outline-[#007bff]"
        />
        <input
            type="text"
            placeholder="Subject"
            class="w-full rounded-md py-3 px-4 bg-gray-100 text-sm outline-[#007bff]"
        />
        <textarea
            placeholder="Message"
            rows="6"
            class="w-full rounded-md px-4 bg-gray-100 text-sm pt-3 outline-[#007bff]"></textarea>
        <Button type="submit" variant="orange" className="min-w-max w-1/2">Submit</Button>
    </form>
</div>
