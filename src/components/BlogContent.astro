---
import type { BlogContentEntry } from "~/lib/blog";

interface Props {
    blog: BlogContentEntry;
}

const { blog } = Astro.props;
const { Content, headings } = await blog.render();

const toc = headings.filter((heading) => heading.depth == 2);
---

<section
    id="content"
    class="container flex flex-col gap-8 lg:flex-row justify-between text-skin-base pt-16 scroll-smooth"
>
    <div class="lg:sticky h-max left-0 top-14 px-2 2xl:px-0flex gap-1 font-opensans">
        <h2 class="text-skin-base font-bold mb-3 text-[clamp(16px,4vw,20px)]">Table of Contents</h2>
        <ul
            class=" list-disc list-inside text-orange-light text-sm text-start"
        >
            {
                toc.map((heading) => (
                    <li class="pl-5">
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                ))
            }
        </ul>
    </div>
    <section class="content px-2 2xl:px-0 lg:w-1/2 mr-auto mt-14 flex flex-col gap-2">
        <Content />
    </section>
</section>