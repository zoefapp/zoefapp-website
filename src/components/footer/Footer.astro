---
// Utils
import { translations, useRoutesAstro } from "~/i18n/utils";
const t = translations(Astro);
import Logo from "../header/Logo.astro";
import NewsletterForm from "~/pages/partial/newsletter/_form.astro";
import { Icon } from "astro-icon/components";
// Data

const routes = useRoutesAstro(Astro);

const FooterData = {
    products: [
        {
            url: routes("passenger"),
            title: t("footer.link.product.first"),
        },
        {
            url: routes("employer"),
            title: t("footer.link.product.second"),
        },
        {
            url: routes("ticket-vendor"),
            title: t("footer.link.product.third"),
        },
    ],
    about: [
        {
            url: routes("aboutUs"),
            title: t("footer.link.about.aboutus"),
        },
        {
            url: routes("contact"),
            title: t("footer.link.about.contact"),
        },
        {
            url: routes("blogs"),
            title: t("footer.link.about.blog"),
        },
    ],
    socials: [
        {
            url: "https://www.facebook.com/zoefapp",
            icon: "simple-icons:facebook",
            text: "Facebook",
        },
        {
            url: "http://instagram.com/zoef.app/",
            icon: "simple-icons:instagram",
            text: "Instagram",
        },
        {
            url: "http://twitter.com/zoefapp",
            icon: "simple-icons:x",
            text: "X",
        },
        {
            url: "https://www.linkedin.com/company/zoefapp/",
            icon: "simple-icons:linkedin",
            text: "Linkedin",
        },
        {
            url: "https://www.tiktok.com/@zoef.app",
            icon: "simple-icons:tiktok",
            text: "Tiktok",
        },
    ],
    law: [
        {
            url: routes("privacy"),
            title: t("footer.privacy"),
        },
        {
            url: routes("terms"),
            title: t("footer.terms"),
        },
        {
            url: routes("cookies"),
            title: t("footer.cookies"),
        },
    ],
};
---

<footer class="bg-gray-50 py-12 mt-12">
    <section class="container flex flex-col md:flex-row justify-between gap-10 px-4 font-semibold">
        <section class="flex flex-col gap-5 md:w-1/2">
            <Logo />
            <h2 class="font-semibold">{t("footer.newsletter.title")}</h2>
            <NewsletterForm />
            <p class="text-xs">{t("footer.newsletter.consent")}</p>
        </section>
        <section class="flex flex-wrap sm:justify-between md:w-1/2 gap-10 md:pr-16">
            <aside class="flex flex-col gap-4 max-sm:w-1/2">
                <h2 class="font-bold">{t("footer.link.product.title")}</h2>
                <ul class="flex flex-col gap-3">
                    {
                        FooterData.products.map((product) => (
                            <li>
                                <a class="hover:underline" href={product.url}>
                                    {product.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </aside>
            <aside class="flex flex-col gap-4">
                <h2 class="font-bold">{t("footer.link.about.title")}</h2>
                <ul class="flex flex-col gap-3">
                    {
                        FooterData.about.map((about) => (
                            <li>
                                <a class="hover:underline" href={about.url}>
                                    {about.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </aside>
            <aside class="flex flex-col gap-4 max-sm:w-full">
                <h2 class="font-bold">{t("footer.socials.title")}</h2>
                <ul class="flex flex-col gap-3">
                    {
                        FooterData.socials.map((social) => (
                            <li class="flex gap-4 items-center text-[14px]">
                                <Icon name={social.icon} class="w-5 h-5" aria-label={social.text} />
                                <a class="hover:underline" href={social.url} target="_blank" rel="noopener noreferrer">
                                    {social.text}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </aside>
        </section>
    </section>
    <section
        class="container flex border-t text-[14px] border-black pt-12 mt-12 flex-col md:flex-row md:justify-between md:items-center gap-4"
    >
        <p>{t("footer.copyright")}</p>
        <aside class="flex gap-4 justify-between">
            {
                FooterData.law.map((law) => (
                    <a href={law.url} class="underline">
                        {law.title}
                    </a>
                ))
            }
        </aside>
    </section>
</footer>
