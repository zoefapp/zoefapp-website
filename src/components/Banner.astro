---
interface Props {
    type: "store" | "signup";
}
const { type } = Astro.props;
// Utils
import { Image } from "astro:assets";
import { translations } from "~/i18n/utils";
const t = translations(Astro);
// Images
import AppStoreIcon from "~/assets/images/icons/app-store.png";
import GooglePlayIcon from "~/assets/images/icons/google-play.png";
import StoreBannerImage from "~/assets/images/store-banner.png";
import SingUpBannerImage from "~/assets/images/signup-banner.png";
// Components
import SignUpForm from "~/pages/partial/signup/_form.astro";
---

<section class="container py-[60px]">
    <section
        class="relative flex flex-col lg:flex-row gap-12 px-8 md:px-12 lg:items-center w-[90%] mx-auto lg:justify-between"
    >
        <aside class="flex flex-col gap-4 w-full lg:w-1/2 mt-10 lg:mt-20">
            <h2 class="text-[clamp(1.5rem,4vw,2rem)] font-bold">{t(`${type}.title`)}</h2>
            <p class="text-balance">{t(`${type}.description`)}</p>
            {
                type === "store" ? (
                    <div class="flex gap-4 mt-8">
                        <a href="https://apps.apple.com/us/app/zoef-app/id6448724232">
                            <Image
                                class="w-auto"
                                height={48}
                                format="avif"
                                loading="lazy"
                                decoding="async"
                                src={AppStoreIcon}
                                alt="App Store Icon"
                            />
                        </a>
                        <a href="https://play.google.com/store/apps/details?id=app.zoef.v2">
                            <Image
                                class="w-auto"
                                height={48}
                                format="avif"
                                loading="lazy"
                                decoding="async"
                                src={GooglePlayIcon}
                                alt="Google Play Icon"
                            />
                        </a>
                    </div>
                ) : (
                    <SignUpForm />
                )
            }
        </aside>
        <aside class="w-full lg:w-1/2 items-end">
            {
                type === "store" ? (
                    <Image
                        src={StoreBannerImage}
                        width={600}
                        quality={80}
                        format="avif"
                        loading="lazy"
                        decoding="async"
                        alt="Store Banner Background"
                        class="w-full max-w-md h-full object-cover mx-auto lg:mx-0 lg:ml-auto"
                    />
                ) : (
                    <Image
                        src={SingUpBannerImage}
                        width={600}
                        quality={80}
                        format="avif"
                        loading="lazy"
                        decoding="async"
                        alt="Sing Up Banner Background"
                        class="w-full max-w-lg h-full py-7 object-cover mx-auto lg:mx-0 lg:ml-auto"
                    />
                )
            }
        </aside>
        <div class="absolute left-0 right-0 bottom-0 top-0 lg:top-20 bg-skin-gradient rounded-xl -z-10"></div>
    </section>
</section>
