---
interface Props {
    person: PeopleContentEntry;
}

import { Image } from "astro:assets";
import type { PeopleContentEntry } from "~/lib/people";

const peopleImages = import.meta.glob<{ default: ImageMetadata }>(["/src/content/people/**/*.{jpeg,jpg,png,gif,webp}"]);

let headerImagePath = Astro.props.person.data.photo ? Astro.props.person.data.photo : "placeholder.jpg";

headerImagePath = "/src/content/people/" + headerImagePath;
const image = peopleImages[headerImagePath]();
---

<Image
    class="w-32 h-32 rounded-full mb-2"
    src={image}
    alt={"Profile picture of " + Astro.props.person.data.name}
    decoding="async"
    quality={100}
    loading="eager"
    fetchpriority="high"
/>
