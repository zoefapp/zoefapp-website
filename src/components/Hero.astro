---
interface Props {
    homePage?: boolean;
    heroImage: ImageMetadata;
}
const { homePage, heroImage } = Astro.props;
import { Image } from "astro:assets";
---

<section
    class={`relative flex container gap-6 md:rounded-2xl flex-col bg-gradient-to-b lg:bg-gradient-to-r from-skin-gradient from-45% to-transparent to-60% lg:flex-row ${!homePage && "md:pb-32"}`}
>
    <aside class="md:px-5 lg:px-12 flex flex-col gap-8 w-full lg:w-1/2 py-6 justify-center">
        <slot name="left" />
    </aside>
    <aside class="w-full max-h-[700px] max-w-2xl max-lg:mx-auto lg:w-1/2 rounded-[100px] md:rounded-2xl overflow-clip">
        <Image
            class="w-full h-full object-bottom object-cover"
            loading="lazy"
            decoding="async"
            width={700}
            src={heroImage}
            alt="Background"
        />
    </aside>
    <slot name="floating" />
</section>
<div
    class={`w-full bg-transparent pointer-events-none ${homePage ? "h-[550px] lg:h-[280px]" : "h-[550px] md:h-[150px]"}`}
>
</div>
