---
interface Props {
    heroImage: ImageMetadata;
}
const { heroImage } = Astro.props;
import { Image } from "astro:assets";
---

<section
    class="relative flex container gap-6 md:rounded-2xl flex-col bg-gradient-to-b lg:bg-gradient-to-r from-skin-gradient from-45% to-transparent to-60% lg:flex-row"
>
    <aside class="px-2 md:px-5 lg:px-12 flex flex-col gap-8 w-full lg:w-1/2 py-6 justify-center">
        <slot name="left" />
    </aside>
    <aside class="w-full max-h-[700px] max-w-2xl max-lg:mx-auto lg:w-1/2 rounded-[100px] md:rounded-2xl overflow-clip">
        <Image
            class="w-full h-full object-bottom object-cover"
            format="avif"
            loading="eager"
            decoding="async"
            width={800}
            src={heroImage}
            alt="Passenger Background"
            quality={80}
        />
    </aside>
    <slot name="floating" />
</section>
<div id="layoutFixer" class="w-full h-0 bg-transparent">
    <!-- I need to be there to fix layout -->
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const layoutFixer = document.getElementById("layoutFixer");
        const floatingElement = document.getElementById("floating");
        const heightOfFloatingElement = floatingElement?.offsetHeight;
        if (!heightOfFloatingElement || !layoutFixer) {
            return;
        }
        layoutFixer.style.paddingTop = `${heightOfFloatingElement}px`;
    });
    window.addEventListener("resize", () => {
        const layoutFixer = document.getElementById("layoutFixer");
        const floatingElement = document.getElementById("floating");
        const heightOfFloatingElement = floatingElement?.offsetHeight;
        if (!heightOfFloatingElement || !layoutFixer) {
            return;
        }
        layoutFixer.style.paddingTop = `${heightOfFloatingElement}px`;
    });
</script>
