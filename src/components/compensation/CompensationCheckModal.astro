---
---

<div class="fixed inset-0 bg-white bg-opacity-75 flex items-center justify-center z-50" id="checkPopup">
    <div class="bg-white p-4 rounded-2xl shadow-[rgba(13,_38,_76,_0.19)_0px_9px_20px] min-w-96 min-h-48 max-w-[600px]">
        <div class="flex flex-col">
            <div class="flex justify-end mb-4">
                <button
                    class="text-orange-light hover:text-gray-700 focus:outline-none"
                    aria-label="Close"
                    onclick="closeCompensationCheckModal()"
                >
                    <svg
                        class="h-6 w-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
                        ></path>
                    </svg>
                </button>
            </div>
            <div class="loading flex items-center justify-center flex-col">
                <h2>Checking delays</h2>
                <div
                    class="inline-flex items-center px-4 py-2 font-semibold leading-6 text-sm rounded-md text-black transition ease-in-out duration-150 cursor-not-allowed"
                >
                    <svg
                        class="animate-spin -ml-1 mr-3 h-5 w-5 text-black"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                    >
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
                        ></circle>
                        <path
                            class="opacity-75"
                            fill="currentColor"
                            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                        ></path>
                    </svg>
                </div>
            </div>
            <div class="flex items-center justify-center flex-col content">
            </div>
        </div>
    </div>
    <script is:inline>
        document.body.addEventListener("htmx:beforeSwap", (ev) => {
            let node = ev.target.parentNode;
            while (node != null) {
                if (node.id == "checkPopup") {
                    node.classList.add("show");
                    return
                }
                node = node.parentNode;
            }
        });

        function closeCompensationCheckModal() {
            document.getElementById("checkPopup")?.classList.remove("show");
        }
    </script>

    <style>
        #checkPopup:not(.show) {
            display: none;
        }
        #checkPopup.htmx-request {
            display: flex;
        }
        #checkPopup.htmx-request div.content {
            display: none;
        }
        #checkPopup:not(.htmx-request) div.loading {
            display: none;
        }
        #checkPopup.htmx-request div.loading {
            display: flex;
        }
    </style>
</div>
