---
import { getLanguage, useRoutes, useTranslations } from "~/i18n/utils";
import Label from "../ui/Label.astro";
import Button from "../ui/Button.astro";
import SelectStation from "../ui/stations/SelectStation.astro";
import DatePicker from "../ui/stations/DatePicker.astro";
import Subtitle from "../ui/Subtitle.astro";
const lang = getLanguage(Astro);
const t = useTranslations(lang);
const eligibilityRoute = useRoutes(lang)("eligibilityCheck");
---

<section
    id="floating"
    class="absolute left-1/2 w-[90%] z-10 rounded-2xl gap-10 transform -translate-x-1/2 container flex flex-col justify-center p-5 md:p-10 min-h-compensation bg-white shadow-custom md:top-[calc(100%-(var(--compensation-height)/4))] lg:top-[calc(100%-(var(--compensation-height)/4))] xl:top-[calc(100%-(var(--compensation-height)/4))] top-[calc(100%-50px)]"
>
    <Subtitle variant="secondary"> 
        <span set:html={t("compensation.title")} />
        <span class="inline-flex items-center justify-center px-2 py-1 mr-2 text-xs font-bold leading-none text-red-100 bg-red-600 rounded-full">beta</span>
    </Subtitle>

    <div>
        <form
        class="flex flex-col lg:flex-row gap-4 items-start lg:items-end"
        hx-trigger="submit"
        hx-indicator="#checkPopup"
        hx-target="#checkPopup div.content"
        hx-get="/partial/check"
        action={eligibilityRoute()}
    >
        <div class="relative flex flex-col gap-2 w-full">
            <Label className="font-bold" for="departure">{t("compensation.departure")}</Label>
            <SelectStation name="departure" id="departure" placeholder={t("compensation.departure.placeholder")} />
        </div>
        <div class="relative flex flex-col gap-2 w-full">
            <Label className="font-bold" for="arrival">{t("compensation.arrival")}</Label>
            <SelectStation name="arrival" id="arrival" placeholder={t("compensation.arrival.placeholder")} />
        </div>
        <div class="flex flex-col gap-2 w-full">
            <Label className="font-bold" for="date">{t("compensation.time")}</Label>
            <DatePicker name="date" placeholder={t("compensation.time.placeholder")} />
        </div>
        <Button type="submit" variant="orange" className="min-w-max w-1/2">{t("compensation.cta")}</Button>
        
    </form>
        <span class="text-sm italic">{t('compensation.note')}</span>
    </div>
    
    
    

</section>
