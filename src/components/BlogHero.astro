---
// Utils
import { getLanguage } from "~/i18n/utils";
import { getBlogUrl, getRecentBlogs } from "~/lib/blog";
import { Image } from "astro:assets";
const lang = getLanguage(Astro);
// Images
import BlogPlaceholderImage from "~/assets/images/blog-placeholder.png";
// Data
const firstBlog = await getRecentBlogs(lang, 1);
---

<section class="relative w-full">
    <section class="container flex flex-col gap-6 py-8">
        <h1 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold">Blog Articles</h1>
        <aside class="relative">
            <Image
                class="aspect-video object-cover rounded-lg"
                src={BlogPlaceholderImage}
                sizes="(max-width: 1400px) 70vw, 1400px"
                widths={[500, 900, 1400]}
                alt="Blog Placeholder Image"
                format="webp"
                decoding="async"
                quality={80}
                loading="eager"
            />
            <p class="absolute top-5 left-5 p-3 text-base font-semibold bg-white text-skin-secondary rounded-xl">
                {firstBlog[0].data.tags.join(", ")}
            </p>
            <section
                class="md:absolute bottom-5 left-5 bg-white rounded-xl max-md:mt-2 md:rounded-2xl flex flex-col p-6"
            >
                <p class="opacity-50 text-[clamp(0.5rem,4vw,0.8rem)]">
                    {
                        firstBlog[0].data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </p>
                <a class="font-bold text-[clamp(1.4rem,4vw,1.8rem)]" href={getBlogUrl(lang, firstBlog[0])}>
                    {firstBlog[0].data.title}
                </a>
            </section>
        </aside>
    </section>
    <div
        class="absolute inset-x-0 top-0 bottom-[50%] md:bottom-[30%] lg:bottom-[10%] bg-skin-gradient rounded-b-3xl md:rounded-t-3xl -z-10"
    >
    </div>
</section>
