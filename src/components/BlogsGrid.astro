---
interface Props {
    blogs: BlogContentEntry[];
}
const { blogs } = Astro.props;
// Utils
import { Icon } from "astro-icon/components";
import type { SupportedLanguages } from "~/i18n/constants";
import { getLanguage } from "~/i18n/utils";
import { getBlogsLength, type BlogContentEntry } from "~/lib/blog";
// Components
import BlogCard from "./BlogCard.astro";
import Button from "./ui/Button.astro";
import Dropdown from "./ui/Dropdown.astro";
// Data
const lang = getLanguage(Astro);
const length = getBlogsLength(lang);

const translate: { [key in SupportedLanguages]: string } = {
    en: "articles",
    nl: "artikelen",
};

const categories = [
    {
        name: "All",
        selected: true,
    },
    {
        name: "Design",
        selected: false,
    },
    {
        name: "Development",
        selected: false,
    },
    {
        name: "Marketing",
        selected: false,
    },
];
---

<section class="container flex flex-col gap-6">
    <aside class="grid grid-cols-2 grid-rows-2 gap-y-3">
        <h2 class="text-[18px]">Filters</h2>
        <div class="flex gap-2 items-center justify-end col-start-2 lg:row-start-2 row-start-1 text-end">
            <Dropdown buttonId="filters-btn" menuId="filters-menu">
                <div class="flex items-center gap-2 text-base" slot="trigger">
                    <p>Sort: New - Old</p>
                    <Icon name="lucide:chevron-down" class="w-6 h-6 text-orange-light" />
                </div>
                <ul class="space-y-2 py-2 px-10 text-sm" slot="menu">
                    <li class="whitespace-nowrap">
                        <button>New - Old</button>
                    </li>
                    <li class="whitespace-nowrap">
                        <button>Old - New</button>
                    </li>
                </ul>
            </Dropdown>
        </div>
        <div
            class="flex row-start-2 col-start-1 items-center gap-3 col-span-2 lg:col-span-1 overflow-x-scroll hide-scrollbar"
        >
            {
                categories.map((category) => (
                    <Button
                        variant="filter"
                        className={category.selected ? "bg-orange-light text-white" : "" + " categoryBtn"}
                    >
                        {category.name}
                    </Button>
                ))
            }
            <button class="text-orange-light hover:underline whitespace-nowrap font-semibold">Reset filters</button>
        </div>
    </aside>
    <aside class="flex flex-col gap-4">
        <h2>{length} {translate[lang]}</h2>
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:grid-cols-3">
            {blogs.map((blog) => <BlogCard blog={blog} />)}
        </section>
    </aside>
</section>
