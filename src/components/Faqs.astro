---
interface Props {
    data: FAQ[];
    image: ImageMetadata;
}
const { data, image } = Astro.props;
import type { FAQ } from "~/lib/faq";
// Utils
import { getLangFromUrl, translations } from "~/i18n/utils";
import { Image } from "astro:assets";
const lang = getLangFromUrl(Astro.url);
const t = translations(Astro);
// Components
import Accordion from "./ui/Accordion.astro";
import Button from "./ui/Button.astro";
import Subtitle from "./ui/Subtitle.astro";
// Data
---

<section class="container py-16 flex flex-col gap-12">
    <section class="w-[90%] mx-auto space-y-10">
        <Subtitle variant="secondary" set:html={t("faqs.title")} />
        <section class="flex flex-col lg:flex-row gap-12 lg:gap-20 justify-between">
            <aside class="flex items-center w-full lg:w-1/2">
                <Accordion data={data} />
            </aside>
            <aside
                class="flex flex-col items-center text-center w-full lg:w-1/2 bg-gray-50 rounded-2xl px-6 py-10 gap-4"
            >
                <Image
                    src={image}
                    alt="FAQs Background"
                    width={300}
                    loading={"lazy"}
                    decoding={"async"}
                    format={"avif"}
                    quality={80}
                />
                <h2 class="font-bold">{t("faqs.side.title")}</h2>
                <p class="text-balance">{t("faqs.side.description")}</p>
                <Button variant="orange">{t("faqs.side.cta")}</Button>
            </aside>
        </section>
    </section>
</section>
