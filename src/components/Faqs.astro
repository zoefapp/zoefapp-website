---
interface Props {
    image: ImageMetadata;
}
const {  image } = Astro.props;
import { getFaqs } from "~/lib/faq";
// Utils
import { Image } from "astro:assets";
import { getLanguage, translations } from "~/i18n/utils";
const t = translations(Astro);
const lang = getLanguage(Astro);
// Components
import Button from "./ui/Button.astro";
import Subtitle from "./ui/Subtitle.astro";
import AccordionContainer from "./ui/accordion/AccordionContainer.astro";
import AccordionItem from "./ui/accordion/AccordionItem.astro";
// Data
const faqs = await getFaqs("passenger", lang);
---

<section class="container py-[60px] flex flex-col gap-12">
    <section class="w-[90%] mx-auto space-y-10">
        <Subtitle variant="secondary" set:html={t("faqs.title")} />
        <section class="flex flex-col lg:flex-row gap-12 lg:gap-20 justify-between">
            <aside class="flex items-center w-full lg:w-1/2">
                <AccordionContainer name="faqs">
                    {faqs.map((faq) => <AccordionItem name="faqs" content={faq.answer} title={faq.question} />)}
                </AccordionContainer>
            </aside>
            <aside
                class="flex flex-col items-center text-center w-full lg:w-1/2 bg-gray-50 rounded-2xl px-6 py-10 gap-6"
            >
                <Image
                    src={image}
                    alt="FAQs Background"
                    width={300}
                    loading={"lazy"}
                    decoding={"async"}
                    format={"avif"}
                    quality={80}
                />
                <h2 class="font-bold">{t("faqs.side.title")}</h2>
                <p class="text-balance">{t("faqs.side.description")}</p>
                <Button variant="orange">{t("faqs.side.cta")}</Button>
            </aside>
        </section>
    </section>
</section>
