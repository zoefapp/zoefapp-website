---
// Utils
import { getLangFromUrl, useT } from "~/i18n/utils";
import { Image } from "astro:assets";
const t = useT(Astro);
// Images
import BannerBackgroundImage from "~/assets/images/store-banner-background.png";
import AppStoreIcon from "~/assets/images/app-store.png";
import GooglePlayIcon from "~/assets/images/google-play.png";
---

<section class="container py-16">
    <section class="relative flex flex-col lg:flex-row gap-12 px-8 lg:items-center w-[90%] mx-auto lg:justify-between">
        <aside class="flex flex-col gap-4 w-full lg:w-1/2 mt-20">
            <h2 class="text-[clamp(1.5rem,4vw,2rem)] font-bold">{t("store.title")}</h2>
            <p class="text-balance">{t("store.description")}</p>
            <div class="flex gap-4 mt-8">
                <a href="">
                    <Image
                        class="w-auto h-12"
                        format="avif"
                        loading="eager"
                        decoding="async"
                        src={AppStoreIcon}
                        alt="App Store Icon"
                    />
                </a>
                <a href="">
                    <Image
                        class="w-auto h-12"
                        format="avif"
                        loading="eager"
                        decoding="async"
                        src={GooglePlayIcon}
                        alt="Google Play Icon"
                    />
                </a>
            </div>
        </aside>
        <aside class="w-full lg:w-1/2">
            <Image
                src={BannerBackgroundImage}
                alt="Store Banner Background"
                class="w-full max-w-md h-full object-cover mx-auto lg:mx-0 lg:ml-auto"
            />
        </aside>
        <div class="absolute left-0 right-0 bottom-0 top-0 lg:top-20 bg-skin-gradient rounded-xl -z-10"></div>
    </section>
</section>
