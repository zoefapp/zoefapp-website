---
import { getBlogUrl, getRecentBlogs } from "~/lib/blog";
import { translations, getLanguage } from "~/i18n/utils";
import { Image } from "astro:assets";

const lang = getLanguage(Astro);
const t = translations(Astro);

// Images
import BlogPlaceholderImage from "~/assets/images/blog-placeholder.png";
// Components
import Subtitle from "./ui/Subtitle.astro";
import Button from "./ui/Button.astro";
// Data
const blogs = await getRecentBlogs(lang, 3);
---

<section class="container py-[60px]">
    <section class="flex flex-col gap-8 w-[90%] mx-auto">
        <aside class="flex flex-col md:flex-row gap-4 justify-between">
            <Subtitle variant="secondary" set:html={t("blogs.title")} />
            <Button variant="orange">{t("blogs.cta")}</Button>
        </aside>
        <aside class="flex flex-col lg:flex-row gap-0 lg:gap-8">
            {
                blogs.map((blog) => (
                    <a href={getBlogUrl(lang, blog)}>
                        <section class="flex flex-col gap-4 w-full max-w-xl mx-auto group">
                            <div class="relative ">
                                <p class="absolute capitalize font-bold top-5 left-5 px-5 py-2 text-xs bg-white text-[#66AE6E] rounded-[12px]">
                                    {blog.data.tags.join(", ")}
                                </p>
                                <Image
                                    loading={"lazy"}
                                    src={BlogPlaceholderImage}
                                    alt="Blog Placeholder"
                                    class="rounded-xl"
                                    format="avif"
                                    decoding="async"
                                    quality={50}
                                    width={576}
                                />
                            </div>
                            <div class="bg-white rounded-2xl max-lg:-translate-y-8 max-lg:px-5 max-lg:py-3 max-lg:w-4/5 max-lg:mx-auto">
                                <p class="opacity-60 text-xs">
                                    {blog.data.date.toLocaleDateString("en-US", {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric",
                                    })}
                                </p>
                                <p class="font-bold text-lg text-pretty group-hover:text-orange-light transition-colors ">
                                    {blog.data.title}
                                </p>
                            </div>
                        </section>
                    </a>
                ))
            }
        </aside>
    </section>
</section>
