---
import { type BlogContentEntry, getBlogUrl } from "~/lib/blog";
import { translations, getLanguage } from "~/i18n/utils";
import { Image } from "astro:assets";

interface Props {
    data: BlogContentEntry[];
}
const { data } = Astro.props;
const lang = getLanguage(Astro)
const t = translations(Astro);

// Images
import BlogPlaceholderImage from "~/assets/images/blog-placeholder.png";
// Components
import Subtitle from "./ui/Subtitle.astro";
import Button from "./ui/Button.astro";
import { getLanguage } from "~/i18n/utils";
// Data
---

<section class="container py-16">
    <section class="flex flex-col gap-20 w-[90%] mx-auto">
        <aside class="flex flex-col md:flex-row gap-4 justify-between">
            <Subtitle variant="secondary" set:html={t("blogs.title")} />
            <Button variant="orange">{t("blogs.cta")}</Button>
        </aside>
        <aside class="flex flex-col lg:flex-row gap-0 lg:gap-8">
            {
                data.map((blog) => (
                    <section class="flex flex-col gap-4 w-full max-w-xl mx-auto">
                        <div class="relative ">
                            <p class="absolute capitalize font-bold top-5 left-5 px-5 py-2 text-xs bg-white text-skin-secondary rounded-[12px]">
                                {blog.data.tags.join(", ")}
                            </p>
                            <Image
                                loading={"lazy"}
                                src={BlogPlaceholderImage}
                                alt="Blog Placeholder"
                                class="rounded-xl"
                                format="avif"
                                decoding="async"
                                quality={50}
                                width={576}
                            />
                        </div>
                        <div class="bg-white rounded-2xl max-lg:-translate-y-8 max-lg:px-5 max-lg:py-3 max-lg:w-4/5 max-lg:mx-auto">
                            <p class="opacity-60 text-xs">
                                {blog.data.date.toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })}
                            </p>
                            <a href={getBlogUrl(lang, blog)} class="font-bold text-lg hover:underline w-max">
                                {blog.data.title}
                            </a>
                        </div>
                    </section>
                ))
            }
        </aside>
    </section>
</section>
