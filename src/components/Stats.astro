---
interface Props {
    data: {
        description: string;
    }[];
}

const { data } = Astro.props;
import { getLanguage, useTranslations } from "~/i18n/utils";
const lang = getLanguage(Astro);
const t = useTranslations(lang);
---

<section
    id="floating"
    class="absolute left-1/2 w-[90%] z-10 gap-4 transform -translate-x-1/2 container flex flex-col justify-center min-h-compensation bg-transparent md:top-[calc(100%-(var(--compensation-height)/1.5))] top-[calc(100%+20px)]"
>
    <h2 class="text-skin-secondary font-bold text-[clamp(1.4rem,4vw,1.7rem)]">{t("stats.title")}</h2>
    <aside class="flex flex-col md:flex-row gap-4">
        {
            data.map((item, index) => (
                <div class="flex flex-col gap-4 items-center justify-center p-5 w-full bg-white shadow-lg shadow-black/20 rounded-2xl border">
                    <h3 class="text-6xl stylish-marker px-10">{index + 1}</h3>
                    <p>{item.description}</p>
                </div>
            ))
        }
    </aside>
</section>
