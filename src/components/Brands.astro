---
import { Icon } from "astro-icon/components";

const brandsData = [
    {
        label: "Apple",
        icon: "simple-icons:apple",
    },
    {
        label: "Google",
        icon: "simple-icons:google",
    },
    {
        label: "Facebook",
        icon: "simple-icons:facebook",
    },
    {
        label: "Twitter",
        icon: "simple-icons:twitter",
    },
];
---

<section class="hidden lg:flex justify-around text-skin-secondary/20 md:py-12 py-32">
    {brandsData.map((brand) => <Icon class="w-8 md:w-11 h-8 md:h-11" name={brand.icon} />)}
    {brandsData.map((brand) => <Icon class="w-8 md:w-11 h-8 md:h-11" name={brand.icon} />)}
</section>

<section class="flex lg:hidden justify-around text-skin-secondary/20 md:py-12 py-32">
    {brandsData.map((brand) => <Icon class="w-8 md:w-11 h-8 md:h-11" name={brand.icon} />)}
</section>
