---
interface Props {
    data: Accomplishment[];
}
type Accomplishment = {
    count: number;
    description: string;
    icon: ImageMetadata;
};
const { data } = Astro.props;
// Utils
import { Image } from "astro:assets";
import { translations } from "~/i18n/utils";
const t = translations(Astro);
// Components
import Subtitle from "./ui/Subtitle.astro";
---

<section class="container py-[60px]">
    <section class="flex flex-col gap-6 w-[90%] mx-auto">
        <Subtitle variant="secondary" set:html={t("accompaniment.title")} />
        <section class="flex flex-col lg:flex-row gap-4">
            {
                data.map((accomplishment, index) => {
                    let aos = "fade-up"
                    if (index == 0) aos = 'fade-right'
                    if (index == data.length - 1) aos = 'fade-left'
                    return (
                        <aside class="flex flex-col gap-2 w-full rounded-2xl bg-[#F9F9F9] p-8" data-aos={aos} data-aos-duration="1000" data-aos-delay="200">
                            <div class="flex gap-3 items-center">
                                <Image src={accomplishment.icon} alt="Euro Icon" width={35} />
                                <p class="font-bold text-[44px]">{accomplishment.count}+</p>
                            </div>
                            <p class="text-[clamp(1rem,1vw,1.2rem)] text-pretty">{accomplishment.description}</p>
                        </aside>
                    );
                })
            }
        </section>
    </section>
</section>
