---
import { getLanguage, useRoutes } from "~/i18n/utils";
import Dropdown from "./ui/Dropdown.astro";
import { Icon } from "astro-icon/components";
import { routes, type IRoutes } from "~/i18n/routes";
import { languages } from "../i18n/ui";
import type { SupportedLanguage } from "~/i18n/constants";
const lang = getLanguage(Astro);

function translateCurrentPath(otherLang: SupportedLanguage): string {
    let otherLangRoutes = useRoutes(otherLang)

    let firstLevel = Astro.url.pathname.split('/')[2]
    let routeEntries = Object.entries(routes[lang])
    for (let index in routeEntries) {
        let routeKey = routeEntries[index][0] as keyof IRoutes
        let routeValue = routeEntries[index][1]
        if (typeof routeValue !== 'string' ) {
            // we do not support moving between dynamic routes
            continue
        }

        if (routeValue === firstLevel) {
            return otherLangRoutes(routeKey) as string
        }
    }
    // fallback to passenger route
    return otherLangRoutes('passenger')
}


---

<Dropdown buttonId="language-picker-btn" menuId="language-picker-menu">
    <Fragment slot="trigger">
        <p class="flex items-center gap-2 font-bold">
            {lang.toUpperCase()}
            {
                lang === "en" ? (
                    <Icon name="openmoji:flag-united-kingdom" class="w-6 h-6" />
                ) : (
                    <Icon name="openmoji:flag-netherlands" class="w-6 h-6" />
                )
            }
        </p>
        <svg class="-mr-1 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd"
            >
            </path>
        </svg>
    </Fragment>
    <Fragment slot="menu">
        {
            Object.entries(languages).map(([otherLang, label]) => (
                <li class="px-5 py-1.5">
                    <a href={lang == otherLang ? '' : translateCurrentPath(otherLang)}>{label}</a>
                </li>
            ))
        }
    </Fragment>
</Dropdown>
