---
// Components
import LanguagePicker from "../LanguagePicker.astro";
import CTAButton from "./CTAButton.astro";
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
const currentPage = Astro.url.pathname.split("/")[2];

// Tailwind doesn't support dynamic classes, so this is a workaround
// Don't delete the variable, it is used
const possibleClasses = "bg-passenger bg-passagier bg-employer bg-werkgever bg-ticket-vendor bg-ticketverkoper";
---

<header class={`container flex h-16 items-center justify-between font-semibold bg-${currentPage} md:bg-transparent`}>
    <div class="flex w-full gap-12 items-center">
        <Logo />
        <Navigation />
    </div>
    <div class="hidden lg:flex justify-end gap-4 items-center">
        <LanguagePicker />
        <CTAButton />
    </div>
</header>
