---
// Utils
import { getLanguage, useRoutes, useTranslations } from "~/i18n/utils";
const lang = getLanguage(Astro);
const t = useTranslations(lang);
const routes = useRoutes(lang);
// Components
import { Icon } from "astro-icon/components";
import LanguagePicker from "../LanguagePicker.astro";
import Dropdown from "../ui/Dropdown.astro";
import CTAButton from "./CTAButton.astro";
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
const currentPage = Astro.url.pathname.replace(/\/$/, "").split("/")[2];
// Data
const navLinks = [
    {
        title: t("nav.link.passenger"),
        url: routes("passenger"),
        class: "bg-passenger",
    },
    {
        title: t("nav.link.employer"),
        url: routes("employer"),
        class: "bg-employer",
    },
    {
        title: t("nav.link.ticket-vendor"),
        url: routes("ticket-vendor"),
        class: "bg-ticket-vendor",
    },
];
// Tailwind doesn't support dynamic classes, so this is a workaround
// Don't delete the variable, it is used
const possibleClasses = "bg-passenger bg-passagier bg-employer bg-werkgever bg-ticket-vendor bg-ticketverkoper";
possibleClasses;
const clearedCurrentPage = Astro.url.pathname.replace(/\/$/, "");
const isCleared = navLinks.some((link) => link.url === clearedCurrentPage);
const dataState = isCleared ? "true" : "false";
---

<header
    class={`container flex flex-col z-[99999] gap-4 ${isCleared ? "h-32" : "h-16"} md:h-16 md:items-center justify-center md:justify-between font-semibold bg-${isCleared ? currentPage : "passenger"} md:bg-transparent`}
>
    <aside class="flex w-full justify-between">
        <div class="flex w-full pl-0 md:pl-10  gap-12 items-center">
            <a href="/"><Logo isEager /></a>
            <Navigation />
        </div>
        <div class="hidden lg:flex justify-end gap-4 items-center">
            <LanguagePicker />
            <CTAButton />
        </div>
    </aside>
    <aside data-state={dataState} class="flex gap-2 items-center md:hidden data-[state=false]:hidden">
        <p class="font-bold text-lg">{t("nav.dropdown.text")}</p>
        <Dropdown buttonId="dropdown-btnn" menuId="dropdown-menuu">
            <div
                slot="trigger"
                style={`color: hsla(var(--${currentPage}));`}
                class="flex items-center px-2 text-lg gap-2 bg-brand p-1 rounded-md"
            >
                <p>{currentPage.charAt(0).toUpperCase() + currentPage.slice(1).split("-").join(" ")}</p>
                <Icon aria-hidden name="lucide:chevron-down" class="w-5 h-5" />
            </div>
            <ul slot="menu">
                {
                    navLinks.map((link) => (
                        <li
                            style={`background-color: ${currentPage === link.url && `var(--${link.class})`}`}
                            class="px-6 py-2 w-full whitespace-nowrap"
                        >
                            <a href={link.url}>{link.title}</a>
                        </li>
                    ))
                }
            </ul>
        </Dropdown>
    </aside>
</header>
