---
// Utils
import { getLangFromUrl, useRoutes, useTranslations } from "~/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const routes = useRoutes(lang);
// Components
import LanguagePicker from "../LanguagePicker.astro";
import CTAButton from "./CTAButton.astro";
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
import Dropdown from "../ui/Dropdown.astro";
import { Icon } from "astro-icon/components";
const currentPage = Astro.url.pathname.split("/")[2];
// Data
const navLinks = [
    {
        title: t("nav.link.passenger"),
        url: routes("passenger"),
        class: "bg-passenger",
    },
    {
        title: t("nav.link.employer"),
        url: routes("employer"),
        class: "bg-employer",
    },
    {
        title: t("nav.link.ticket-vendor"),
        url: routes("ticket-vendor"),
        class: "bg-ticket-vendor",
    },
];
// Tailwind doesn't support dynamic classes, so this is a workaround
// Don't delete the variable, it is used
const possibleClasses = "bg-passenger bg-passagier bg-employer bg-werkgever bg-ticket-vendor bg-ticketverkoper";
---

<header
    class={`container flex flex-col gap-4 h-28 md:h-16 md:items-center justify-center md:justify-between font-semibold bg-${currentPage} md:bg-transparent`}
>
    <aside class="flex w-full justify-between">
        <div class="flex w-full gap-12 items-center">
            <Logo isEager />
            <Navigation />
        </div>
        <div class="hidden lg:flex justify-end gap-4 items-center">
            <LanguagePicker />
            <CTAButton />
        </div>
    </aside>
    <aside class="flex gap-2 items-center md:hidden">
        <p class="font-bold">{t("nav.dropdown.text")}</p>
        <Dropdown buttonId="dropdown-btn" menuId="dropdown-menu">
            <div
                slot="trigger"
                style={`color: hsla(var(--${currentPage}));`}
                class="flex items-center px-2 text-base gap-2 bg-brand p-1 rounded-md"
            >
                <p>{currentPage.charAt(0).toUpperCase() + currentPage.slice(1)}</p>
                <Icon aria-hidden name="lucide:chevron-down" class="w-4 h-4" />
            </div>
            <ul slot="menu">
                {
                    navLinks.map((link) => (
                        <li
                            style={`background-color: ${currentPage === link.url && `var(--${link.class})`}`}
                            class="px-8 py-2 w-full"
                        >
                            <a href={link.url}>{link.title}</a>
                        </li>
                    ))
                }
            </ul>
        </Dropdown>
    </aside>
</header>

<script itemscope is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const button = document.getElementById("dropdown-btn");
        const menu = document.getElementById("dropdown-menu");

        button.addEventListener("click", () => menu.classList.toggle("hidden"));

        document.addEventListener("click", (event) => {
            if (!button.contains(event.target) && !menu.contains(event.target)) {
                menu.classList.add("hidden");
            }
        });
    });
</script>
