---
// Components
import LanguagePicker from "../LanguagePicker.astro";
import CTAButton from "./CTAButton.astro";
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
---

<header class="container flex h-16 items-center justify-between font-semibold">
    <div class="flex w-full gap-12 items-center">
        <Logo />
        <Navigation />
    </div>
    <div class="hidden lg:flex justify-end gap-4 items-center">
        <LanguagePicker />
        <CTAButton />
    </div>
</header>

<style is:inline>
    /* Dynamic values dont work with TailwindCSS, so this is a workaround */
    /* Could've used clsx instead but it means more code */
    /* This works as well */
    @media screen and (max-width: 768px) {
        header {
            background-color: var(--passenger);
        }
    }
</style>
