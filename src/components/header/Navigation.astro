---
import { Icon } from "astro-icon/components";
import { routes as Routes } from "~/i18n/routes";
import { languages } from "~/i18n/ui";
import { getLangFromUrl, useRoutes, useTranslations } from "~/i18n/utils";
import Dropdown from "../ui/Dropdown.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const routes = useRoutes(lang);
const currentPage = Astro.url.pathname;

const navLinks = [
    {
        title: t("nav.link.passenger"),
        url: routes("passenger"),
        class: "bg-passenger",
    },
    {
        title: t("nav.link.employer"),
        url: routes("employer"),
        class: "bg-employer",
    },
    {
        title: t("nav.link.ticket-vendor"),
        url: routes("ticket-vendor"),
        class: "bg-ticket-vendor",
    },
    {
        title: t("nav.link.about"),
        url: routes("aboutUs"),
        class: "bg-passenger",
    },
];
---

<nav class="flex w-full">
    <!-- Desktop Nav -->
    <ul class="hidden md:flex">
        {
            navLinks.map((link) => (
                <li class={`px-6 py-5 ${currentPage === link.url && `${link.class}`}`}>
                    <a href={link.url}>{link.title}</a>
                </li>
            ))
        }
    </ul>
    <!-- Mobile Nav -->
    <Dropdown className="block md:hidden ml-auto" buttonId="mobilenav-picker" menuId="mobilenav-menu">
        <div slot="trigger" class="bg-brand p-1 text-passenger rounded-md">
            <span class="sr-only">Menu Toggle</span>
            <Icon aria-hidden name="lucide:align-justify" class="w-6 h-6" />
        </div>
        <ul slot="menu">
            <li
                style={`background-color: ${currentPage === navLinks[navLinks.length - 1].url && `var(--${navLinks[navLinks.length - 1].class})`}`}
                class="px-12 py-2 w-full"
            >
                <a class="whitespace-nowrap" href={navLinks[navLinks.length - 1].url}>
                    {navLinks[navLinks.length - 1].title}
                </a>
            </li>
            {
                Object.entries(languages).map(([lang, label]) => (
                    <li class="flex gap-2 px-12 py-2 w-full">
                        {lang === "en" ? (
                            <Icon name="openmoji:flag-united-kingdom" class="w-6 h-6" />
                        ) : (
                            <Icon name="openmoji:flag-netherlands" class="w-6 h-6" />
                        )}
                        <a href={`/${lang + "/" + Routes[lang].passenger}`}>{label}</a>
                    </li>
                ))
            }
        </ul>
    </Dropdown>
</nav>

<!-- Dropdown Script -->
<script itemscope is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const button = document.getElementById("mobilenav-picker");
        const menu = document.getElementById("mobilenav-menu");

        button.addEventListener("click", () => menu.classList.toggle("hidden"));

        document.addEventListener("click", (event) => {
            if (!button.contains(event.target) && !menu.contains(event.target)) {
                menu.classList.add("hidden");
            }
        });
    });
</script>
