---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useRoutes, useTranslations } from "~/i18n/utils";
import Dropdown from "../ui/dropdown.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const routes = useRoutes(lang);
const currentPage = Astro.url.pathname;

const navLinks = [
    {
        title: t("nav.link.passenger"),
        url: routes("passenger"),
        class: "passenger",
    },
    {
        title: t("nav.link.employer"),
        url: routes("employer"),
        class: "employer",
    },
    {
        title: t("nav.link.ticket-vendor"),
        url: routes("ticket-vendor"),
        class: "ticketvendor",
    },
    {
        title: t("nav.link.about"),
        url: routes("aboutUs"),
        class: "aboutus",
    },
];
---

<nav class="flex w-full">
    <!-- Desktop Nav -->
    <ul class="hidden md:flex">
        {
            navLinks.map((link) => (
                <li style={`background-color: ${currentPage === link.url && `var(--${link.class})`}`} class="px-6 py-5">
                    <a href={link.url}>{link.title}</a>
                </li>
            ))
        }
    </ul>
    <!-- Mobile Nav -->
    <Dropdown className="block md:hidden ml-auto" buttonId="mobilenav-picker" menuId="mobilenav-menu">
        <div slot="trigger" class="bg-brand p-1 text-passenger rounded-md">
            <span class="sr-only">Menu Toggle</span>
            <Icon aria-hidden name="lucide:align-justify" class="w-6 h-6" />
        </div>
        <ul slot="menu">
            {
                navLinks.map((link) => (
                    <li
                        style={`background-color: ${currentPage === link.url && `var(--${link.class})`}`}
                        class="px-[calc(100vw/4)] py-2 w-full"
                    >
                        <a href={link.url}>{link.title}</a>
                    </li>
                ))
            }
        </ul>
    </Dropdown>
</nav>

<script itemscope is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const button = document.getElementById("mobilenav-picker");
        const menu = document.getElementById("mobilenav-menu");

        button.addEventListener("click", () => menu.classList.toggle("hidden"));

        document.addEventListener("click", (event) => {
            if (!button.contains(event.target) && !menu.contains(event.target)) {
                menu.classList.add("hidden");
            }
        });
    });
</script>
