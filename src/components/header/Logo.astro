---
interface Props {
    isEager?: boolean;
}
const { isEager = false } = Astro.props;
import { Image } from "astro:assets";
import logo from "~/assets/images/icons/zoef-logo.png";
---

<Image
    src={logo}
    alt="Logo"
    width={250}
    quality={100}
    loading={isEager ? "eager" : "lazy"}
    decoding={"async"}
    class="min-w-[90px] max-w-[115px] md:w-full shrink-0"
/>
