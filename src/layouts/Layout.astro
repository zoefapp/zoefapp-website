---
import Footer from "~/components/footer/Footer.astro";
import Header from "~/components/header/Header.astro";
import { getLanguage } from "~/i18n/utils";
import type { PageProps } from "~/lib/page";
import "~/styles/globals.css";

interface Props {
    page?: PageProps
}

const lang = getLanguage(Astro);
const props = Astro.props;

---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="lang" content={lang} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/png" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <script>
            import "htmx.org";
            import 'aos/dist/aos.css';
            import AOS from "aos";
            AOS.init()
        </script>
        <title>Zoef.app {props.page?.title && `- ${props.page?.title}`}</title>
        <meta name="title" content={props.page?.title && `- ${props.page?.title}`} />
        <meta name="description" content={props.page?.description} />
        {props.page?.keywords && <meta name="keywords" content={props.page?.keywords} />}
        {props.page?.author && <meta name="author" content={props.page?.author} />}
        {props.page?.ogTitle && <meta property="og:title" content={props.page?.ogTitle} />}
        {props.page?.ogType && <meta property="og:type" content={props.page?.ogType} />}
        {props.page?.ogUrl && <meta property="og:url" content={props.page?.ogUrl} />}
        {props.page?.ogImage && <meta property="og:image" content={props.page?.ogImage} />}
    </head>
    <body class="font-mulish" hx-headers={'{"x-site-lang":"' + lang + '"}'}>
        <Header />
        <slot />
        <Footer />
    </body>
</html>