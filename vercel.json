{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/:lang/(.*)",
            "destination": "/:lang/404/",
            "statusCode": 404
        },
        {
            "source": "/(.*)",
            "destination": "/en/404/",
            "statusCode": 404
        }
    ]
}